---
import { readFile } from "node:fs/promises"
import { dirname } from "node:path"
import { fileURLToPath } from "node:url"
import { Code, TabItem, Tabs } from "@astrojs/starlight/components"
import { compile } from "tailwindcss"
import Preview, { type Stilark } from "./Preview.astro"

interface Props {
  /** Fristil-stilarkene eksempelet trenger. */
  stiler?: Stilark[]
  /** `rad` legger innholdet side om side, `stabel` under hverandre. */
  layout?: "rad" | "stabel"
  /** Valgfri maksbredde. */
  maxWidth?: string
  /** Markupen. Vises både levende og som kode. */
  kode: string
}

const { stiler = [], layout = "rad", maxWidth, kode } = Astro.props

/*
 * Eksempelet kompileres av en ekte Tailwind under bygging.
 *
 * Forhåndsvisningen ligger i en shadow root, og dokumentasjonssidens egne
 * utility-klasser når ikke inn dit. Å skrive dem av for hånd ville gjort
 * eksempelet til en tegning av noe som kanskje virker. Her er det Tailwind
 * selv som lager klassene, av nøyaktig den markupen som står i kodefanen.
 */
async function lastStilark(id: string, basedir: string) {
  const url = id.startsWith(".")
    ? new URL(id, `file://${basedir}/`)
    : new URL(import.meta.resolve(id))
  const sti = fileURLToPath(url)

  return { path: sti, base: dirname(sti), content: await readFile(sti, "utf8") }
}

/** Klassenavnene i markupen, som er det Tailwind skal lage regler for. */
const klasser = [...kode.matchAll(/class="([^"]*)"/g)].flatMap((treff) =>
  treff[1].split(/\s+/).filter(Boolean),
)

const compiler = await compile(
  `
	@import "tailwindcss/theme.css" layer(theme);
	@import "tailwindcss/utilities.css" layer(utilities);
	@import "@fristil/designsystem/tailwind.css";
	`,
  { base: process.cwd(), loadStylesheet: lastStilark },
)

/*
 * En klasse fra Fristils navnerom som ikke finnes, skal felle bygget.
 *
 * Tailwind sier ingenting om en klasse den ikke kjenner: den lager bare ingen
 * regel, og eksempelet ser ut som det virker. Siden sto med tolv navn fra
 * fargesystemet slik det het før matrisen, og ingenting sa fra. Bare
 * `-fs-`-klassene kontrolleres, siden de er våre; `p-4` og `rounded-xl` er
 * Tailwinds egne.
 *
 * Målet er om `build()` ga noe nytt, ikke om en selektor står i utdata.
 * Selektoren måtte i så fall bygges av klassenavnet, og Tailwind escaper `/`,
 * `[`, `!` og et halvt dusin tegn til, så `hover:bg-fs-accent-fill/50` ville
 * blitt meldt som ukjent selv om den finnes. `build()` er dessuten
 * kumulativ, så et navn som er et prefiks av et annet, som `text-fs-accent`
 * mot `text-fs-accent-text`, ikke slipper gjennom på et delstrengtreff.
 */
const ukjente: string[] = []
let lengde = compiler.build([]).length

for (const klasse of new Set(klasser)) {
  if (!klasse.includes("-fs-")) continue
  const ny = compiler.build([klasse]).length
  if (ny <= lengde) ukjente.push(klasse)
  lengde = Math.max(lengde, ny)
}

if (ukjente.length > 0) {
  throw new Error(
    `Tailwind-eksempelet bruker klasser som ikke finnes i temaet: ${ukjente.join(", ")}`,
  )
}

const tailwindCss = compiler.build(klasser)
---

<Tabs>
	<TabItem label="Eksempel">
		<Preview
			stiler={stiler}
			layout={layout}
			maxWidth={maxWidth}
			ekstraCss={tailwindCss}
		>
			<Fragment set:html={kode} />
		</Preview>
	</TabItem>
	<TabItem label="Kode">
		<Code code={kode.trim()} lang="html" />
	</TabItem>
</Tabs>
