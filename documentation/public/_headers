# The content types for the files coding agents fetch.
#
# The Astro routes set `content-type` in `new Response(...)`, but a static
# build writes only the body to a file, and the headers are lost. Netlify
# infers the type from the extension, and then `charset` is left out. Both
# files can contain characters outside ASCII, so it is not a detail.
/llms.txt
  Content-Type: text/plain; charset=utf-8

/agent/*
  Content-Type: text/markdown; charset=utf-8
