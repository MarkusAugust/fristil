{
  "name": "fristil-vscode",
  "displayName": "Fristil",
  "description": "Fullføring, forklaringer, snippets, feilmeldinger og hurtigrettelser for Fristil-designsystemet: <fs-*>-elementene, fs-klassene og variantene deres.",
  "version": "0.3.0",
  "publisher": "Fristil",
  "license": "MIT",
  "icon": "ikon.png",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MarkusAugust/fristil.git",
    "directory": "editor"
  },
  "homepage": "https://fristil.netlify.app/",
  "engines": {
    "vscode": "^1.90.0"
  },
  "main": "./dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "categories": [
    "Snippets",
    "Linters",
    "Other"
  ],
  "keywords": [
    "fristil",
    "designsystem",
    "web-components",
    "html",
    "css",
    "lint"
  ],
  "contributes": {
    "html": {
      "customData": [
        "./fristil.html-data.json"
      ]
    },
    "snippets": [
      {
        "language": "html",
        "path": "./snippets.json"
      },
      {
        "language": "php",
        "path": "./snippets.json"
      },
      {
        "language": "razor",
        "path": "./snippets.json"
      },
      {
        "language": "aspnetcorerazor",
        "path": "./snippets.json"
      },
      {
        "language": "astro",
        "path": "./snippets.json"
      },
      {
        "language": "svelte",
        "path": "./snippets.json"
      },
      {
        "language": "vue",
        "path": "./snippets.json"
      },
      {
        "language": "twig",
        "path": "./snippets.json"
      },
      {
        "language": "blade",
        "path": "./snippets.json"
      },
      {
        "language": "jinja",
        "path": "./snippets.json"
      },
      {
        "language": "jinja-html",
        "path": "./snippets.json"
      },
      {
        "language": "django-html",
        "path": "./snippets.json"
      },
      {
        "language": "handlebars",
        "path": "./snippets.json"
      },
      {
        "language": "erb",
        "path": "./snippets.json"
      },
      {
        "language": "gotmpl",
        "path": "./snippets.json"
      },
      {
        "language": "go-template",
        "path": "./snippets.json"
      },
      {
        "language": "ejs",
        "path": "./snippets.json"
      },
      {
        "language": "liquid",
        "path": "./snippets.json"
      },
      {
        "language": "nunjucks",
        "path": "./snippets.json"
      },
      {
        "language": "edge",
        "path": "./snippets.json"
      }
    ],
    "configurationDefaults": {
      "[html]": {
        "editor.snippetSuggestions": "top"
      }
    },
    "configuration": {
      "title": "Fristil",
      "properties": {
        "fristil.languages": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [
            "html",
            "php",
            "razor",
            "aspnetcorerazor",
            "astro",
            "svelte",
            "vue",
            "twig",
            "blade",
            "jinja",
            "jinja-html",
            "django-html",
            "handlebars",
            "erb",
            "gotmpl",
            "go-template",
            "ejs",
            "liquid",
            "nunjucks",
            "edge"
          ],
          "description": "Språkene, som VS Code-språk-id-er, der utvidelsen sjekker markupen og fullfører klasser og verdier. Fullføringen av <fs-*>-elementene fra VS Codes egen HTML-tjeneste gjelder bare html."
        }
      }
    }
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "build": "bun build src/extension.ts --outfile dist/extension.js --target node --format cjs --external vscode",
    "sjekk": "bun scripts/sjekk.ts && bun scripts/sjekk-diagnostikk.ts && bun run build && vsce package --no-dependencies --out fristil.vsix",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@fristil/designsystem": "workspace:*",
    "@types/node": "24.12.4",
    "@types/vscode": "1.90.0",
    "@vscode/vsce": "^3.6.0",
    "ovsx": "^1.2.0"
  }
}
