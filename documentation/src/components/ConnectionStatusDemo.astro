---
import Preview from "./Preview.astro"
---

<Preview
	id="demo-connection"
	styles={["connection-status", "button"]}
	maxWidth="34rem"
	layout="stack"
	fixedInside
	extraCss={`
		/* Only for the preview: the bar sits at the top of the box, as it sits
		   at the top of the window in an app. The space here keeps it from
		   covering the buttons. A consumer needs none of this. */
		.surface { padding-block-start: var(--lt-spacing-12); }
	`}
>
	<div class="demo-connection-buttons">
		<button class="lt-button" id="demo-connection-off" type="button">Simulate a failed request</button>
		<button class="lt-button" data-variant="secondary" id="demo-connection-on" type="button">Simulate it working again</button>
	</div>
	<lt-connection-status class="lt-connection-status" data-ignore-morph></lt-connection-status>
</Preview>

<script>
	import { defineLtConnectionStatus } from "@lo-tek/interfaces/connection-status"

	defineLtConnectionStatus()

	// The preview sits in a shadow root, so we go through the host element.
	const surface = document.getElementById("demo-connection")?.shadowRoot
	const status = surface?.querySelector("lt-connection-status")

	surface?.getElementById("demo-connection-off")?.addEventListener("click", () => {
		status?.reportFailure()
	})
	surface?.getElementById("demo-connection-on")?.addEventListener("click", () => {
		status?.reportSuccess()
	})
</script>
