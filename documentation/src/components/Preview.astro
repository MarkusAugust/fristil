---
import accordion from "@lo-tek/interfaces/accordion.css?inline"
import alert from "@lo-tek/interfaces/alert.css?inline"
import avatar from "@lo-tek/interfaces/avatar.css?inline"
import badge from "@lo-tek/interfaces/badge.css?inline"
import breadcrumbs from "@lo-tek/interfaces/breadcrumbs.css?inline"
import button from "@lo-tek/interfaces/button.css?inline"
import card from "@lo-tek/interfaces/card.css?inline"
import checkbox from "@lo-tek/interfaces/checkbox.css?inline"
import connectionStatus from "@lo-tek/interfaces/connection-status.css?inline"
import dialog from "@lo-tek/interfaces/dialog.css?inline"
import divider from "@lo-tek/interfaces/divider.css?inline"
import errorSummary from "@lo-tek/interfaces/error-summary.css?inline"
import errorText from "@lo-tek/interfaces/error-text.css?inline"
import field from "@lo-tek/interfaces/field.css?inline"
import fieldset from "@lo-tek/interfaces/fieldset.css?inline"
import fileUpload from "@lo-tek/interfaces/file-upload.css?inline"
import heading from "@lo-tek/interfaces/heading.css?inline"
import helpText from "@lo-tek/interfaces/help-text.css?inline"
import icon from "@lo-tek/interfaces/icon.css?inline"
import input from "@lo-tek/interfaces/input.css?inline"
import label from "@lo-tek/interfaces/label.css?inline"
import link from "@lo-tek/interfaces/link.css?inline"
import list from "@lo-tek/interfaces/list.css?inline"
import pagination from "@lo-tek/interfaces/pagination.css?inline"
import paragraph from "@lo-tek/interfaces/paragraph.css?inline"
import popover from "@lo-tek/interfaces/popover.css?inline"
import progress from "@lo-tek/interfaces/progress.css?inline"
import radio from "@lo-tek/interfaces/radio.css?inline"
import search from "@lo-tek/interfaces/search.css?inline"
import select from "@lo-tek/interfaces/select.css?inline"
import sessionTimeout from "@lo-tek/interfaces/session-timeout.css?inline"
import skeleton from "@lo-tek/interfaces/skeleton.css?inline"
import skipLink from "@lo-tek/interfaces/skip-link.css?inline"
import spinner from "@lo-tek/interfaces/spinner.css?inline"
import srOnly from "@lo-tek/interfaces/sr-only.css?inline"
import suggestion from "@lo-tek/interfaces/suggestion.css?inline"
import switchCss from "@lo-tek/interfaces/switch.css?inline"
import table from "@lo-tek/interfaces/table.css?inline"
import tabs from "@lo-tek/interfaces/tabs.css?inline"
import tag from "@lo-tek/interfaces/tag.css?inline"
import textarea from "@lo-tek/interfaces/textarea.css?inline"
import toast from "@lo-tek/interfaces/toast.css?inline"
import toggleGroup from "@lo-tek/interfaces/toggle-group.css?inline"
import tooltip from "@lo-tek/interfaces/tooltip.css?inline"

const STILARK = {
  alert,
  progress,
  table,
  tabs,
  toast,
  list,
  tag,
  avatar,
  skeleton,
  breadcrumbs,
  pagination,
  "skip-link": skipLink,
  accordion,
  dialog,
  search,
  "toggle-group": toggleGroup,
  tooltip,
  heading,
  paragraph,
  badge,
  button,
  card,
  checkbox,
  divider,
  "session-timeout": sessionTimeout,
  "connection-status": connectionStatus,
  "error-text": errorText,
  "error-summary": errorSummary,
  "file-upload": fileUpload,
  field,
  fieldset,
  "help-text": helpText,
  icon,
  input,
  label,
  link,
  radio,
  popover,
  select,
  spinner,
  "sr-only": srOnly,
  suggestion,
  switch: switchCss,
  textarea,
} as const

export type Stilark = keyof typeof STILARK

interface Props {
  /** The stylesheets the example needs, the same ones you would import in an app. */
  styles?: Stilark[]
  /**
   * `rad` lays the content out side by side, `stabel` one below the other.
   * `flow` is ordinary block flow, where margins collapse as they do on a
   * real page. In `stabel` the surface is a flex column, and there the
   * margins and the gap add up.
   */
  layout?: "row" | "stack" | "flow"
  /** Optional maximum width, for example "34rem". */
  maxWidth?: string
  /** Id of the host element, for demos that need to find their way in with script. */
  id?: string
  /**
   * CSS added last in the shadow root.
   *
   * Two uses: utility classes compiled by Tailwind, and customising that
   * applies only to the preview, such as room for a bar that sits at the top
   * of the box. The latter is the alternative to a `style=` attribute in the
   * example, and must always have a comment saying the reader does not need it.
   */
  extraCss?: string
  /**
   * Keep `position: fixed` inside the box.
   *
   * Some components fix their content to the window, such as the bar from
   * `<lt-connection-status>` at the top and the messages from `<lt-toast>` in
   * the corner. In an app that is right. In the documentation it was not: the
   * reader pressed the button in the middle of the page, and the bar appeared
   * at the top of the window, behind the documentation site's fixed header.
   * It looked as if nothing happened.
   */
  fixedInside?: boolean
}

const {
  styles = [],
  layout = "row",
  maxWidth,
  id,
  extraCss,
  fixedInside = false,
} = Astro.props

for (const navn of styles) {
  if (!(navn in STILARK)) {
    throw new Error(
      `Preview: unknown stylesheet "${navn}". Valid: ${Object.keys(STILARK).join(", ")}`,
    )
  }
}

/*
 * The preview sits in a shadow root, created declaratively by the browser.
 * That is not decoration: without it the documentation site's CSS hits the
 * elements in the example, and a rule that targets <p> directly beats the
 * inherited text colour regardless of specificity.
 *
 * The isolation also keeps the example honest: it shows exactly what a
 * consumer gets with the stylesheets below, and nothing the documentation
 * site happens to do.
 *
 * The surface follows the theme. The CSS variables are set on :root by
 * tokens.css and inherited through the shadow boundary, so both light and
 * dark themes come through without anything being repeated here.
 */
const stilark = [
  `
	:host {
		display: block;
	}

	.surface {
		display: flex;
		gap: var(--lt-spacing-3);
		padding: var(--lt-spacing-6);
		max-width: var(--lt-preview-max-width, none);
		background: var(--lt-color-neutral-canvas);
		color: var(--lt-color-neutral-text-strong);
		border: 1px solid var(--lt-color-neutral-border-subtle);
		border-radius: var(--lt-spacing-1);
		font-family: inherit;
		font-size: var(--lt-font-size-m);
		line-height: 1.6;
	}

	/* Only for the preview. Layout containment makes the box the containing
	   block for a fixed-position child, so the reader sees the result where
	   they pressed rather than at the top of the window. A consumer does not
	   need this, and should not copy it. */
	.surface[data-fast-inni] {
		contain: layout;
	}

	.surface[data-layout="row"] {
		flex-wrap: wrap;
		align-items: center;
	}

	.surface[data-layout="stack"] {
		flex-direction: column;
		align-items: stretch;
	}

	.surface[data-layout="flow"] {
		display: block;
	}

	/* Deliberately no reset here. The surface must show exactly what a
	   consumer gets with the stylesheets below and the browser's own
	   defaults. If something looks odd, it is the component that is missing
	   something, not the preview. */
	`,
  ...styles.map((navn) => STILARK[navn]),
  extraCss ?? "",
].join("\n")
---

<div class="lt-preview not-content" id={id}>
	<template shadowrootmode="open">
		<style set:html={stilark}></style>
		<div
			class="surface"
			data-layout={layout}
			data-fast-inni={fixedInside ? "" : undefined}
			style={maxWidth ? `--lt-preview-max-width: ${maxWidth}` : undefined}
		>
			<slot />
		</div>
	</template>
</div>
