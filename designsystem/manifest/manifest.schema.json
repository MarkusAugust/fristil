{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fristil.sobernetics.no/manifest.schema.json",
  "title": "Fristils manifest",
  "description": "Det Fristil lover: elementene, klassene med innholdet og delene sine, og byggefunksjonene. Generert av designsystem/scripts/generate-manifest.ts fra koden, aldri skrevet for hånd.",
  "type": "object",
  "required": ["schemaVersion", "version", "elements", "classes", "builders"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1,
      "description": "Formen på fila. Økes bare når en leser må endres for å forstå den."
    },
    "version": {
      "type": "string",
      "description": "Versjonen av @fristil/designsystem manifestet er skrevet fra."
    },
    "elements": {
      "type": "object",
      "description": "Hvert <fs-…>-element, med attributtene komponenten leser.",
      "additionalProperties": {
        "type": "object",
        "required": ["link", "attributes"],
        "properties": {
          "link": {
            "type": "string"
          },
          "description": {
            "type": "string",
            "description": "Hva elementet gjør, i én eller to setninger."
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "$ref": "#/$defs/elementAttribute"
            }
          },
          "parts": {
            "type": "object",
            "description": "Delene elementet finner i markupen den som rendrer skriver, med selektoren det leter etter. Et tomt objekt når elementet lager sine egne noder.",
            "additionalProperties": {
              "$ref": "#/$defs/part"
            }
          },
          "events": {
            "type": "object",
            "description": "Hendelsene elementet sender. Alle bobler og krysser skyggegrenser. Mangler når elementet ikke sender noe.",
            "additionalProperties": {
              "type": "object",
              "properties": {
                "detail": {
                  "type": "object",
                  "description": "Feltene i event.detail med typen sin. Mangler når hendelsen ikke har noe.",
                  "additionalProperties": {
                    "enum": ["boolean", "string", "number"]
                  }
                }
              }
            }
          }
        }
      }
    },
    "classes": {
      "type": "object",
      "description": "Hver fs-klasse, med komponenten den hører til og attributtene den tar.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "component",
          "title",
          "description",
          "link",
          "content",
          "attributes"
        ],
        "properties": {
          "component": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "link": {
            "type": "string"
          },
          "content": {
            "description": "Hva elementet med klassen tar som innhold, med samme ord som delene: «text» er tekst, «free» er hva som helst, «parts» er bare delene, og «none» er ingen tekst, som en kontroll.",
            "enum": ["text", "free", "parts", "none"]
          },
          "partOf": {
            "type": "string",
            "description": "Klassen denne er en del av, når den bare er en del av en annen komponents markup, som fs-card__title i fs-card. Forelderen har en del som treffer den."
          },
          "parts": {
            "type": "object",
            "description": "Delene markupen består av, for klassene med en fast struktur, med selektoren relativt til elementet med klassen. Mangler for klassene uten.",
            "additionalProperties": {
              "$ref": "#/$defs/part"
            }
          },
          "attributes": {
            "type": "object",
            "additionalProperties": {
              "description": "Et attributt med en lukket liste over verdier, eller et flagg, som er på når det står der.",
              "oneOf": [
                {
                  "type": "object",
                  "required": ["values"],
                  "properties": {
                    "values": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "default": {
                      "description": "Verdien fraværet betyr.",
                      "type": "string"
                    },
                    "description": {
                      "type": "string",
                      "description": "Hva attributtet gjør, hentet fra valget i byggefunksjonen som skriver det."
                    }
                  },
                  "additionalProperties": false
                },
                {
                  "type": "object",
                  "required": ["flag"],
                  "properties": {
                    "flag": {
                      "const": true
                    },
                    "description": {
                      "type": "string",
                      "description": "Hva attributtet gjør, hentet fra valget i byggefunksjonen som skriver det."
                    }
                  },
                  "additionalProperties": false
                }
              ]
            }
          }
        }
      }
    },
    "builders": {
      "type": "array",
      "description": "Hver byggefunksjon i fs, med valgene og formen på svaret.",
      "items": {
        "type": "object",
        "required": ["name", "options", "returns"],
        "properties": {
          "name": {
            "type": "string"
          },
          "options": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["name", "required", "type"],
              "properties": {
                "name": {
                  "type": "string"
                },
                "required": {
                  "type": "boolean"
                },
                "type": {
                  "$ref": "#/$defs/optionType"
                },
                "description": {
                  "type": "string",
                  "description": "Hva valget gjør, hentet fra kommentaren på valget i typen."
                }
              }
            }
          },
          "returns": {
            "$ref": "#/$defs/returns"
          },
          "table": {
            "description": "Når valgene virker hver for seg: grunnmengden og det hvert valg bidrar med, utledet av svarene og etterprøvd mot hvert byggetilfelle. Et annet språk kan lage byggefunksjonen fra den alene.",
            "oneOf": [
              {
                "type": "object",
                "required": ["kind", "table"],
                "properties": {
                  "kind": {
                    "const": "attributes"
                  },
                  "table": {
                    "$ref": "#/$defs/table"
                  }
                }
              },
              {
                "type": "object",
                "required": ["kind", "fields"],
                "properties": {
                  "kind": {
                    "const": "group"
                  },
                  "fields": {
                    "type": "object",
                    "additionalProperties": {
                      "$ref": "#/$defs/table"
                    }
                  }
                }
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "elementAttribute": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type"],
          "properties": {
            "type": {
              "enum": ["flag", "text", "number"]
            },
            "description": {
              "type": "string",
              "description": "Hva attributtet gjør."
            }
          }
        },
        {
          "type": "object",
          "required": ["type", "values"],
          "properties": {
            "type": {
              "const": "values"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": {
              "type": "string",
              "description": "Hva attributtet gjør."
            }
          }
        }
      ]
    },
    "optionType": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["flag", "text", "number", "textList"]
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "values"],
          "properties": {
            "kind": {
              "const": "values"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      ]
    },
    "returns": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind"],
          "properties": {
            "kind": {
              "enum": ["attributes", "text"]
            },
            "optional": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "values"],
          "properties": {
            "kind": {
              "const": "values"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "optional": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "of"],
          "properties": {
            "kind": {
              "const": "list"
            },
            "of": {
              "$ref": "#/$defs/returns"
            },
            "optional": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": ["kind", "fields"],
          "properties": {
            "kind": {
              "const": "group"
            },
            "fields": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/returns"
              }
            },
            "optional": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "attributes": {
      "type": "object",
      "description": "Attributtnavn til verdi. Tom tekst er et boolsk attributt som er på, null fjerner attributtet, og {navn} er verdien av valget med det navnet.",
      "additionalProperties": {
        "type": ["string", "null"]
      }
    },
    "table": {
      "type": "object",
      "required": ["base", "options"],
      "properties": {
        "base": {
          "$ref": "#/$defs/attributes"
        },
        "options": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["cases"],
            "properties": {
              "cases": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/$defs/attributes"
                }
              },
              "template": {
                "$ref": "#/$defs/attributes"
              },
              "empty": {
                "$ref": "#/$defs/attributes"
              }
            }
          }
        }
      }
    },
    "part": {
      "type": "object",
      "required": ["selector", "description", "content"],
      "properties": {
        "selector": {
          "type": "string",
          "description": "CSS-selektoren elementet finner delen med, slik den står i koden."
        },
        "description": {
          "type": "string",
          "description": "Hva delen er, og hvordan elementet kjenner den igjen."
        },
        "content": {
          "description": "Hva delen skal inneholde: «text» er tekst, «free» er hva som helst, «parts» er andre deler i lista, og «none» er ingen tekst: en kontroll, som et <select> med sine <option>, eller et element komponenten fyller.",
          "enum": ["text", "free", "parts", "none"]
        },
        "multiple": {
          "const": true,
          "description": "Delen kan stå flere ganger."
        },
        "optional": {
          "const": true,
          "description": "Elementet virker uten delen."
        }
      },
      "additionalProperties": false
    }
  }
}
