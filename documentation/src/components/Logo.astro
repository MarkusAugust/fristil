---
export interface Props {
  size?: "sm" | "md" | "lg"
  className?: string
  /** The words "Design system" under the name. The front page has them in the heading right below, so there it is off. */
  subtitle?: boolean
}

const { size = "md", className = "", subtitle = true } = Astro.props

const sizeMap = {
  sm: { svg: 40, gap: "12px", textSize: "1.4rem", subtitleSize: "0.65rem" },
  md: { svg: 60, gap: "16px", textSize: "2.2rem", subtitleSize: "0.8rem" },
  lg: { svg: 80, gap: "18px", textSize: "3rem", subtitleSize: "1rem" },
}

const s = sizeMap[size]
const cyanId = `lotekCyan-${size}`
const lillaId = `lotekLilla-${size}`
---

<div
  class:list={["lotek-logo-wrapper", className]}
  style={`display: flex; align-items: center; gap: ${s.gap}; font-family: 'Inter', sans-serif;`}
>
  <svg
    width={s.svg}
    height={s.svg}
    viewBox="0 0 100 100"
    fill="none"
    xmlns="http://www.w3.org/2000/svg"
    style="flex-shrink: 0;"
  >
    <defs>
      <linearGradient id={cyanId} gradientUnits="userSpaceOnUse" x1="5" y1="2" x2="60" y2="98">
        <stop offset="0%" stop-color="#00f2fe" />
        <stop offset="100%" stop-color="#4facfe" />
      </linearGradient>
      <linearGradient id={lillaId} gradientUnits="userSpaceOnUse" x1="24" y1="21" x2="60" y2="45">
        <stop offset="0%" stop-color="#4facfe" />
        <stop offset="100%" stop-color="#b15cff" />
      </linearGradient>
    </defs>
    <!-- Two layers that sit against each other without overlapping: markup and behaviour. -->
    <path d="M5 2H88L74 16H19V40H71L57 54H19V84L5 98Z" fill={`url(#${cyanId})`} />
    <path d="M24 21H76L95 2V35H24ZM24 59H59L78 40V73H38V98H12L24 86Z" fill={`url(#${lillaId})`} />
  </svg>

  <div style="display: flex; flex-direction: column; line-height: 1;">
    <span
      style={`font-size: ${s.textSize}; font-weight: 800; letter-spacing: -0.03em; color: currentColor;`}
    >
      LO-TEK
    </span>
    {subtitle && (
      <span
        style={`font-size: ${s.subtitleSize}; font-weight: 600; letter-spacing: 0.15em; text-transform: uppercase; color: currentColor; opacity: 0.6; margin-top: 4px;`}
      >
        Design system
      </span>
    )}
  </div>
</div>
