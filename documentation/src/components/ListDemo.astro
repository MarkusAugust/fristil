---
import Preview from "./Preview.astro"
---

<Preview
	id="demo-list"
	styles={[
		"search",
		"tag",
		"table",
		"skeleton",
		"alert",
		"button",
		"label",
		"sr-only",
		"heading",
		"paragraph",
	]}
	layout="stack"
	maxWidth="34rem"
	extraCss={`
		/* The layout is the app's, not the system's: LO-TEK provides the
		   search field, the tags and the table, while the space between them
		   belongs to the page that puts them together. */
		#demo-list-root {
			display: flex;
			flex-direction: column;
			gap: var(--lt-spacing-5);
		}

		.demo-filters {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--lt-spacing-2);
		}

		.demo-filters h3 {
			flex-basis: 100%;
			margin: 0 0 var(--lt-spacing-1);
		}

		#demo-reload {
			align-self: start;
		}
	`}
>
	<div id="demo-list-root">
		<form role="search" class="lt-search-row" id="demo-search-form">
			<label class="lt-label lt-sr-only" for="demo-search">Search cases</label>
			<input
				class="lt-input lt-search"
				type="search"
				id="demo-search"
				name="q"
				placeholder="Search cases"
			/>
		</form>

		<div role="group" aria-labelledby="demo-filters" class="demo-filters">
			<h3 class="lt-heading" data-size="xs" id="demo-filters">Status</h3>
			<button class="lt-tag" data-selectable aria-pressed="false" type="button" data-status="Approved">Approved</button>
			<button class="lt-tag" data-selectable aria-pressed="false" type="button" data-status="Under review">Under review</button>
			<button class="lt-tag" data-selectable aria-pressed="false" type="button" data-status="Rejected">Rejected</button>
		</div>

		<p class="lt-sr-only" role="status" id="demo-matches"></p>

		<div id="demo-result"></div>

		<button class="lt-button" data-variant="secondary" type="button" id="demo-reload">
			Reload the list
		</button>
	</div>
</Preview>

<script>
	type Sak = { nummer: string; dato: string; sendt: string; status: string }

	const SAKER: Sak[] = [
		{ nummer: "2026-0481", dato: "4 March", sendt: "2026-03-04", status: "Under review" },
		{ nummer: "2026-0377", dato: "12 February", sendt: "2026-02-12", status: "Approved" },
		{ nummer: "2025-1204", dato: "3 December", sendt: "2025-12-03", status: "Rejected" },
		{ nummer: "2025-0988", dato: "14 October", sendt: "2025-10-14", status: "Approved" },
	]

	/*
	 * The sorting is the demo's, not the system's. LO-TEK provides the button
	 * and the arrow, and reads the direction from `aria-sort`. Which column is
	 * sorted is known only here, and is written out as `aria-sort` on one
	 * header.
	 */
	type Kolonne = "nummer" | "sendt"
	type Retning = "ascending" | "descending"
	let sortering: { column: Kolonne; retning: Retning } = {
		column: "sendt",
		retning: "descending",
	}
	let viste: Sak[] = []

	function sorter(saker: Sak[]): Sak[] {
		const { column, retning } = sortering
		const fortegn = retning === "ascending" ? 1 : -1
		return [...saker].sort(
			(a, b) => fortegn * a[column].localeCompare(b[column]),
		)
	}

	function overskrift(column: Kolonne, tekst: string): string {
		const sortert = sortering.column === column
		return `<th scope="col"${sortert ? ` aria-sort="${sortering.retning}"` : ""}>
			<button type="button" class="lt-table__sort" data-column="${column}">${tekst}</button>
		</th>`
	}

	const surface = document.getElementById("demo-list")?.shadowRoot
	const rot = surface?.getElementById("demo-list-root")
	const resultat = surface?.getElementById("demo-result")
	const treff = surface?.getElementById("demo-matches")
	const sok = surface?.getElementById("demo-search") as HTMLInputElement | null

	/** The demo fails on purpose every third load, to show the error state. */
	let lastinger = 0

	function valgteFiltre(): string[] {
		return [...(rot?.querySelectorAll(".lt-tag[aria-pressed='true']") ?? [])].map(
			(knapp) => (knapp as HTMLElement).dataset.status ?? "",
		)
	}

	function visLaster() {
		if (!resultat) return
		resultat.innerHTML = `
			<div aria-busy="true">
				${'<div class="lt-skeleton" data-variant="text" aria-hidden="true"></div>'.repeat(3)}
			</div>`
		if (treff) treff.textContent = "Loading cases"
	}

	function visFeil() {
		if (!resultat) return
		resultat.innerHTML = `
			<div class="lt-alert" data-color="danger" role="alert">
				<p class="lt-alert__title">Could not fetch the cases</p>
				<p>The network did not respond. Try again.</p>
			</div>`
		// The alert has role="alert" and is announced by itself. The status
		// element is emptied, so the message does not come twice.
		if (treff) treff.textContent = ""
	}

	function visTomt(sokeord: string) {
		if (!resultat) return
		resultat.innerHTML = `
			<div>
				<p class="lt-paragraph"><strong id="demo-empty"></strong></p>
				<p class="lt-paragraph" data-size="small">Try another search term, or remove the filters.</p>
				<button class="lt-button" data-variant="secondary" type="button" id="demo-reset">
					Clear the search
				</button>
			</div>`
		// `textContent` and not straight into `innerHTML`: the search text is
		// written by the user, and `<img onerror=…>` in the search field would
		// have run.
		const tomt = surface?.getElementById("demo-empty")
		if (tomt) {
			tomt.textContent = `No cases match${sokeord ? ` “${sokeord}”` : ""}.`
		}
		if (treff) treff.textContent = "No matches"

		surface?.getElementById("demo-reset")?.addEventListener("click", () => {
			if (sok) sok.value = ""
			for (const knapp of rot?.querySelectorAll(".lt-tag") ?? []) {
				knapp.setAttribute("aria-pressed", "false")
			}
			tegn()
		})
	}

	function visSaker(saker: Sak[]) {
		if (!resultat) return
		viste = saker
		resultat.innerHTML = `
			<div class="lt-table-scroll" tabindex="0" role="region" aria-label="Cases">
				<table class="lt-table" data-variant="striped">
					<caption class="lt-sr-only">Cases that match the search. Columns with a button can be sorted.</caption>
					<thead>
						<tr>${overskrift("nummer", "Case number")}${overskrift("sendt", "Sent")}<th scope="col">Status</th></tr>
					</thead>
					<tbody>
						${sorter(saker)
							.map(
								(sak) => `<tr>
									<th scope="row">${sak.nummer}</th>
									<td>${sak.dato}</td>
									<td>${sak.status}</td>
								</tr>`,
							)
							.join("")}
					</tbody>
				</table>
			</div>`

		// Only when the count is different: sorting redraws the same cases, and
		// the same text written in again is announced again.
		const antall = saker.length === 1 ? "1 case" : `${saker.length} cases`
		if (treff && treff.textContent !== antall) treff.textContent = antall
	}

	function tegn() {
		lastinger += 1
		visLaster()

		window.setTimeout(() => {
			if (lastinger % 3 === 0) {
				visFeil()
				return
			}

			const sokeord = (sok?.value ?? "").trim().toLowerCase()
			const filtre = valgteFiltre()

			const passer = SAKER.filter(
				(sak) =>
					(sokeord === "" ||
						sak.nummer.toLowerCase().includes(sokeord) ||
						sak.status.toLowerCase().includes(sokeord)) &&
					(filtre.length === 0 || filtre.includes(sak.status)),
			)

			if (passer.length === 0) visTomt(sokeord)
			else visSaker(passer)
		}, 450)
	}

	// Search while the user types, but not on every keystroke: the number of
	// matches is announced, and that would interrupt the announcement all the
	// time.
	let tidsavbrudd: number
	sok?.addEventListener("input", () => {
		window.clearTimeout(tidsavbrudd)
		tidsavbrudd = window.setTimeout(tegn, 300)
	})

	surface?.getElementById("demo-search-form")?.addEventListener("submit", (hendelse) => {
		hendelse.preventDefault()
		tegn()
	})

	for (const knapp of rot?.querySelectorAll(".lt-tag[data-selectable]") ?? []) {
		knapp.addEventListener("click", () => {
			const valgt = knapp.getAttribute("aria-pressed") === "true"
			knapp.setAttribute("aria-pressed", String(!valgt))
			tegn()
		})
	}

	surface?.getElementById("demo-reload")?.addEventListener("click", tegn)

	// Sorting fetches nothing again, it draws the same cases in a new order.
	// The table is replaced, so focus has to be put back on the button the
	// user pressed, or it lands on `<body>`.
	resultat?.addEventListener("click", (hendelse) => {
		const knapp = (hendelse.target as Element).closest<HTMLElement>(".lt-table__sort")
		const column = knapp?.dataset.column as Kolonne | undefined
		if (!column) return

		sortering = {
			column,
			retning:
				sortering.column === column && sortering.retning === "ascending"
					? "descending"
					: "ascending",
		}
		visSaker(viste)
		resultat
			.querySelector<HTMLElement>(`.lt-table__sort[data-column="${column}"]`)
			?.focus()
	})

	tegn()
</script>
