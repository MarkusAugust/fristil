---
/**
 * Sideskjelettet som en ekte side, ikke en tegning av en.
 *
 * Mønsteret handler om landemerker, overskriftsnivåer og hopplenken, og det
 * lar seg ikke vise i en boks inne i en dokumentasjonsside: hopplenken skal
 * være det første i `<body>`, og `<main>` kan bare finnes én gang per side.
 * Derfor er demoen en egen adresse, som vises i en ramme på mønstersiden og
 * kan åpnes for seg selv.
 *
 * Siden er bygget av LO-TEKs egne komponenter, uten Tailwind, så det som
 * står her er det samme som en konsument ville skrevet.
 */

import { lt } from "@lo-tek/interfaces"

import "@lo-tek/interfaces/tokens.css"
import "@lo-tek/interfaces/skip-link.css"
import "@lo-tek/interfaces/breadcrumbs.css"
import "@lo-tek/interfaces/heading.css"
import "@lo-tek/interfaces/paragraph.css"
import "@lo-tek/interfaces/link.css"
import "@lo-tek/interfaces/button.css"
import "@lo-tek/interfaces/card.css"
import "@lo-tek/interfaces/badge.css"
import "@lo-tek/interfaces/list.css"
import "@lo-tek/interfaces/divider.css"

/*
 * Klassen fra `lt.*` må trekkes ut og slås sammen med sidens egen for hånd.
 * Skriver du `{...lt.list()} class="min-klasse"`, skriver Astro ut begge
 * attributtene, og nettleseren beholder den første. Den egne klassen blir
 * altså borte uten at noe sier fra, og menyen lå lenge under hverandre i en
 * kolonne av nettopp den grunnen.
 */
const { class: listeKlasse, ...liste } = lt.list({ variant: "plain" })
---

<!doctype html>
<html lang="nb">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<link rel="icon" href="/favicon.svg" type="image/svg+xml" />
		<title>Mine saker | Eksempelkommune</title>
		<meta
			name="description"
			content="Demo av sideskjelettet i LO-TEK: hopplenke, landemerker og overskriftsnivåer i en hel side."
		/>
	</head>
	<body>
		<a {...lt.skipLink()} href="#hovedinnhold">Hopp til hovedinnhold</a>

		<header class="skjelett-topp">
			<div class="skjelett-bredde skjelett-toppinnhold">
				<a class="skjelett-merke" href="#" aria-label="Eksempelkommune, til forsiden">
					Eksempelkommune
				</a>

				<nav aria-label="Hovedmeny">
					<ul {...liste} class={`${listeKlasse} skjelett-meny`}>
						<li><a href="#" aria-current="page">Mine saker</a></li>
						<li><a href="#">Søknader</a></li>
						<li><a href="#">Kontakt oss</a></li>
					</ul>
				</nav>
			</div>
		</header>

		<div class="skjelett-bredde skjelett-sti">
			<nav aria-label="Du er her">
				<ol {...lt.breadcrumbs()}>
					<li><a {...lt.link()} href="#">Forsiden</a></li>
					<li><a {...lt.link()} href="#">Min side</a></li>
					<li><a {...lt.link()} href="#" aria-current="page">Mine saker</a></li>
				</ol>
			</nav>
		</div>

		<main id="hovedinnhold" tabindex="-1" class="skjelett-bredde skjelett-hoved">
			<h1 {...lt.heading({ size: "xl" })}>Mine saker</h1>

			<p {...lt.paragraph({ variant: "lead" })}>
				Her finner du sakene dine, og hva som skjer med dem.
			</p>

			<section aria-labelledby="til-behandling">
				<h2 {...lt.heading({ size: "m" })} id="til-behandling">Til behandling</h2>

				<ul {...liste} class={`${listeKlasse} skjelett-saker`}>
					<li>
						<article {...lt.card()}>
							<h3 class={lt.card.title}>Søknad om bostøtte</h3>
							<p {...lt.paragraph({ size: "small" })}>
								Sendt 4. mars 2026. Saksnummer 2026-0481.
							</p>
							<p><span {...lt.badge({ color: "warning" })}>Mangler vedlegg</span></p>
							<p>
								<a {...lt.link()} href="#">Se hva som mangler</a>
							</p>
						</article>
					</li>
					<li>
						<article {...lt.card()}>
							<h3 class={lt.card.title}>Søknad om barnehageplass</h3>
							<p {...lt.paragraph({ size: "small" })}>
								Sendt 12. februar 2026. Saksnummer 2026-0377.
							</p>
							<p><span {...lt.badge({ color: "success" })}>Innvilget</span></p>
							<p>
								<a {...lt.link()} href="#">Se vedtaket</a>
							</p>
						</article>
					</li>
				</ul>
			</section>

			<hr {...lt.divider()} />

			<section aria-labelledby="ny-soknad">
				<h2 {...lt.heading({ size: "m" })} id="ny-soknad">Ny søknad</h2>
				<p {...lt.paragraph()}>
					Du kan søke om bostøtte hver måned. Fristen er den 25.
				</p>
				<p><button {...lt.button()} type="button">Start ny søknad</button></p>
			</section>
		</main>

		<footer class="skjelett-bunn">
			<div class="skjelett-bredde">
				<p {...lt.paragraph({ size: "small" })}>
					Eksempelkommune, postboks 1, 0000 Eksempelby. Telefon 00 00 00 00.
				</p>
			</div>
		</footer>

		<style is:global>
			/*
			 * Oppsettet er appens, ikke designsystemets.
			 *
			 * LO-TEK gir komponentene og tokenene. Bredden på spalten, luften
			 * mellom delene og fargen på topp og bunn hører til siden, og står
			 * derfor her. Alle verdiene er tokens, så siden følger temaet.
			 */
			/* Sida følger systemet gjennom tokenene, så rullefelt og
			   skjemakontroller må følge med. LO-TEK setter ikke denne på
			   `:root`, fordi en verdi der ville gjeldt hele dokumentet også
			   der pakken bare er en gjest. Den står på <html>, siden
			   rullefeltet i vinduet følger rotelementet. */
			html {
				color-scheme: light dark;
			}

			body {
				margin: 0;
				background: var(--lt-color-neutral-canvas);
				color: var(--lt-color-neutral-text-strong);
				font-family:
					system-ui,
					-apple-system,
					"Segoe UI",
					sans-serif;
			}

			.skjelett-bredde {
				box-sizing: border-box;
				/* LO-TEK har ingen CSS-token for spaltebredde. Den er appens valg. */
				max-inline-size: 60rem;
				margin-inline: auto;
				padding-inline: var(--lt-spacing-4);
			}

			/*
			 * Topplinja er appens merkevare, og skrives derfor uten LO-TEKs
			 * lenkefarge. Det er mulig fordi systemets CSS ligger i
			 * @layer lotek: reglene her vinner uten !important.
			 */
			.skjelett-topp {
				background: var(--lt-color-accent-fill);
				color: var(--lt-color-accent-content);
			}

			.skjelett-toppinnhold {
				display: flex;
				flex-wrap: wrap;
				align-items: center;
				justify-content: space-between;
				gap: var(--lt-spacing-4);
				padding-block: var(--lt-spacing-4);
			}

			/* Fargen settes, ikke arves: menyen står i en `.lt-list`, som selv
			   setter tekstfargen, og `inherit` hadde hentet den derfra og gitt
			   mørk tekst på den blå flaten. */
			.skjelett-topp a {
				color: var(--lt-color-accent-content);
				text-decoration: none;
			}

			.skjelett-topp a:hover {
				text-decoration: underline;
			}

			.skjelett-topp a:focus-visible {
				outline: 2px solid var(--lt-color-accent-content);
				outline-offset: 3px;
			}

			.skjelett-merke {
				font-size: var(--lt-font-size-l);
				font-weight: 700;
				letter-spacing: -0.01em;
			}

			.skjelett-meny {
				display: flex;
				flex-wrap: wrap;
				gap: var(--lt-spacing-5);
			}

			.skjelett-meny li + li {
				margin-block-start: 0;
			}

			/* Siden du står på markeres med strek, ikke bare med farge. */
			.skjelett-meny [aria-current="page"] {
				text-decoration: underline;
				text-underline-offset: 0.35em;
				text-decoration-thickness: 2px;
			}

			.skjelett-sti {
				padding-block: var(--lt-spacing-4) 0;
			}

			.skjelett-hoved {
				display: flex;
				flex-direction: column;
				gap: var(--lt-spacing-5);
				padding-block: var(--lt-spacing-5) var(--lt-spacing-7);
			}

			/* Overskriften og ingressen hører sammen, og skal stå tettere på
			   hverandre enn på seksjonene under. */
			.skjelett-hoved > h1 {
				margin-block-end: calc(var(--lt-spacing-5) * -1 + var(--lt-spacing-2));
			}

			.skjelett-hoved section {
				display: flex;
				flex-direction: column;
				gap: var(--lt-spacing-3);
			}

			.skjelett-saker {
				display: grid;
				gap: var(--lt-spacing-3);
			}

			.skjelett-saker li + li {
				margin-block-start: 0;
			}

			.skjelett-bunn {
				margin-block-start: var(--lt-spacing-6);
				padding-block: var(--lt-spacing-5);
				background: var(--lt-color-neutral-surface);
				border-block-start: 1px solid var(--lt-color-neutral-border-subtle);
			}

			/* Fokusmarkeringen på hovedinnholdet er til for hopplenken, og skal
			   ikke vises når brukeren bare klikker et sted på siden. */
			main:focus {
				outline: none;
			}

			main:focus-visible {
				outline: 2px solid var(--lt-color-accent-fill);
				outline-offset: 4px;
			}
		</style>
	</body>
</html>
