---
import { lt } from "@lo-tek/interfaces"
import Preview from "./Preview.astro"

// Serveren skriver hele boksen: klassen, rollen, tabbestoppen og
// overskriften. Komponenten flytter bare fokus og tar klikk på lenkene.
const feil = lt.errorSummary({ count: 2, id: "demo-oppsummering" })
---

<Preview
	id="demo-error-summary"
	stiler={["error-summary", "list", "label", "input", "button", "error-text"]}
	layout="stabel"
	maxWidth="34rem"
>
	<form id="demo-skjema" novalidate>
		<lt-error-summary {...feil.host} data-autofocus="false">
			<h2 {...feil.title}>Skjemaet har to feil</h2>
			<ul class="lt-list">
				<li><a href="#demo-epost">Skriv en e-postadresse med krøllalfa</a></li>
				<li><a href="#demo-dato">Skriv datoen som dag, måned og år</a></li>
			</ul>
		</lt-error-summary>

		<label class="lt-label" for="demo-epost">E-postadresse</label>
		<input class="lt-input" id="demo-epost" type="email" value="ola.nordmann" data-state="invalid" aria-invalid="true" />

		<label class="lt-label" for="demo-dato">Fødselsdato</label>
		<input class="lt-input" id="demo-dato" type="date" data-state="invalid" aria-invalid="true" />
	</form>
</Preview>

<script>
	import { defineLtErrorSummary } from "@lo-tek/interfaces/error-summary"

	defineLtErrorSummary()
</script>
