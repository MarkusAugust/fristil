---
import Preview from "./Preview.astro"
---

<Preview id="demo-field" stiler={["field"]} layout="stabel" maxWidth="34rem">
	<lt-field>
		<label class="lt-label" for="demo-epost-input" data-required="text">E-postadresse</label>
		<input
			id="demo-epost-input"
			class="lt-input"
			type="email"
			placeholder="ola@eksempel.no"
			required
		/>
		<p class="lt-help-text">Vi sender kvittering til denne adressen.</p>
		<p class="lt-error-text" id="demo-epost-feil" hidden>Skriv en e-postadresse med krøllalfa.</p>
	</lt-field>

	<lt-field optional="">
		<label for="demo-melding">Melding til saksbehandler</label>
		<textarea id="demo-melding" class="lt-textarea" rows="3" placeholder="Skriv en kort melding"></textarea>
		<p class="lt-help-text">Du kan skrive opptil 500 tegn.</p>
	</lt-field>
</Preview>

<script>
	import { defineLtField } from "@lo-tek/interfaces/field"

	defineLtField()

	// Forhåndsvisningen ligger i en shadow root, så document.getElementById
	// når ikke inn. Vi går via vertselementet.
	const flate = document.getElementById("demo-field")?.shadowRoot
	const feil = flate?.getElementById("demo-epost-feil")
	const input = flate?.getElementById("demo-epost-input") as HTMLInputElement | null

	if (feil && input) {
		const erGyldig = () =>
			input.value === "" || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value)

		// Feltet er ugyldig når feilmeldingen synes. Komponenten setter da
		// aria-invalid og kobler meldingen til feltet.
		input.addEventListener("blur", () => {
			feil.hidden = erGyldig()
		})

		input.addEventListener("input", () => {
			if (!feil.hidden) feil.hidden = erGyldig()
		})
	}
</script>
