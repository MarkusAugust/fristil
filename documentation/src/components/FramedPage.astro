---
/**
 * Shows a whole page in a frame, with a way to open it on its own.
 *
 * Some patterns are about the page as a whole: the skip link must be the first
 * thing in `<body>`, `<main>` can only exist once, and the landmarks only make
 * sense in relation to each other. None of that can be shown in a box inside
 * another page. The demo is therefore a real page at its own address, shown
 * here in an `<iframe>` and openable in its own tab.
 *
 * The frame has its own viewport width, so what you see is what the page
 * actually does at that width, with no scaling tricks.
 */

interface Props {
  /** The address of the demo page. */
  src: string
  /** What the frame contains. Becomes `title`, which screen readers announce. */
  title: string
  /** The height of the frame. */
  height?: string
  /**
   * Whether the page in the frame takes the theme the reader chose for the
   * documentation. Off for a demo whose point is to follow the system by
   * itself, such as the theme picker.
   */
  followTheme?: boolean
}

const { src, title, height = "34rem", followTheme = true } = Astro.props
---

<figure class="framed-page not-content">
	<iframe
		src={src}
		title={title}
		loading="lazy"
		style={`height: ${height}`}
		data-follow-theme={followTheme ? "" : undefined}
	></iframe>

	<figcaption>
		<a href={src} target="_blank" rel="noreferrer">
			Open {title.toLowerCase()} in a new tab
		</a>
		<span> (there, Tab and the skip link work as on a real page)</span>
	</figcaption>
</figure>

<script>
	/*
	 * The demo is its own page, so by itself it follows the system, while the
	 * documentation around it follows the reader's choice. Chosen light on a
	 * dark phone gave a dark page inside a light one. The frame is on the same
	 * origin, so the documentation hands its resolved theme to the page in the
	 * frame when it loads and whenever the reader changes it. `color-scheme`
	 * goes along, because the demo sets `light dark` on its own `<html>`, and
	 * scrollbars and form controls read that.
	 */
	const root = document.documentElement

	function handOver(frame: HTMLIFrameElement) {
		const html = frame.contentDocument?.documentElement
		const theme = root.dataset.theme
		if (!html || (theme !== "light" && theme !== "dark")) return
		html.dataset.theme = theme
		html.style.colorScheme = theme
	}

	const frames = [
		...document.querySelectorAll<HTMLIFrameElement>(
			".framed-page iframe[data-follow-theme]",
		),
	]
	for (const frame of frames) {
		frame.addEventListener("load", () => handOver(frame))
		handOver(frame)
	}
	new MutationObserver(() => frames.forEach(handOver)).observe(root, {
		attributes: true,
		attributeFilter: ["data-theme"],
	})
</script>

<style>
	.framed-page {
		margin: 0;
		display: flex;
		flex-direction: column;
		gap: var(--lt-spacing-2);
	}

	.framed-page iframe {
		inline-size: 100%;
		border: 1px solid var(--lt-color-neutral-border-subtle);
		border-radius: 0;
		background: var(--lt-color-neutral-canvas);
		/* The frame is a separate page, and scrolls on its own. */
		overflow: auto;
	}

	.framed-page figcaption {
		font-size: var(--lt-font-size-s);
		color: var(--lt-color-neutral-text-subtle);
	}

	.framed-page a {
		color: var(--lt-color-accent-fill);
	}
</style>
