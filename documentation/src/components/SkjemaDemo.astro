---
import Preview from "./Preview.astro"
---

<Preview
	id="demo-skjema"
	stiler={[
		"error-summary",
		"list",
		"label",
		"input",
		"help-text",
		"error-text",
		"button",
		"sr-only",
	]}
	layout="stabel"
	maxWidth="34rem"
	ekstraCss={`
		/* Oppsettet er appens valg, ikke systemets. Fristil gir feltene,
		   mens avstanden mellom dem hører til skjemaet som setter dem
		   sammen. To felt som står klistret til hverandre leses som ett. */
		#demo-soknad {
			display: flex;
			flex-direction: column;
			gap: var(--size-5);
		}

		/* Knappen skal ha mer luft over seg enn feltene har mellom seg, så
		   den ikke ser ut som en del av det siste feltet. */
		.demo-knapperad {
			margin-block-start: var(--size-2);
		}
	`}
>
	<form id="demo-soknad" novalidate>
		<fs-error-summary
			id="demo-feil"
			class="fs-error-summary"
			role="alert"
			tabindex="-1"
			autofocus="false"
			hidden
		>
			<h2 class="fs-error-summary__title">Skjemaet kan ikke sendes</h2>
			<ul class="fs-list"></ul>
		</fs-error-summary>

		<div>
			<label class="fs-label" data-required="symbol" for="demo-epost">E-postadresse</label>
			<input
				class="fs-input"
				id="demo-epost"
				name="epost"
				type="email"
				required
				aria-describedby="demo-epost-hjelp"
			/>
			<p class="fs-help-text" id="demo-epost-hjelp">Vi sender kvittering hit.</p>
			<p class="fs-error-text" id="demo-epost-feil" hidden></p>
		</div>

		<div>
			<label class="fs-label" data-required="symbol" for="demo-fodselsdato">Fødselsdato</label>
			<input
				class="fs-input"
				id="demo-fodselsdato"
				name="fodselsdato"
				type="date"
				data-variant="date"
				required
			/>
			<p class="fs-error-text" id="demo-fodselsdato-feil" hidden></p>
		</div>

		<div class="demo-knapperad">
			<button class="fs-button" type="submit">Send søknaden</button>
		</div>

		<p class="fs-sr-only" role="status" id="demo-status"></p>
	</form>
</Preview>

<script>
	import { defineFsErrorSummary } from "@fristil/designsystem/error-summary"

	defineFsErrorSummary()

	// Forhåndsvisningen ligger i en shadow root, så vi går via vertselementet.
	const flate = document.getElementById("demo-skjema")?.shadowRoot
	const skjema = flate?.getElementById("demo-soknad") as HTMLFormElement | null
	const oppsummering = flate?.getElementById("demo-feil")
	const status = flate?.getElementById("demo-status")
	const felter = skjema ? [...skjema.querySelectorAll("input")] : []

	/** Felt brukeren har skrevet i, og som derfor kan få en feilmelding. */
	const rort = new Set<HTMLInputElement>()
	let forsokt = false

	/**
	 * Meldingene er våre egne, ikke nettleserens engelske standardtekster.
	 *
	 * E-postadressen sjekkes i tillegg til `type="email"`. Nettleseren godtar
	 * `ola@eksempel`, uten toppdomene, siden det er en gyldig adresse på et
	 * internt nett. I et skjema som sender kvittering på e-post er det nesten
	 * alltid en skrivefeil.
	 */
	const ADRESSE = /^[^\s@]+@[^\s@.]+(\.[^\s@.]+)+$/

	function meldingFor(felt: HTMLInputElement): string {
		if (felt.value === "") {
			return felt.name === "epost"
				? "Skriv e-postadressen din"
				: "Skriv fødselsdatoen din"
		}

		if (felt.name === "epost") {
			return felt.checkValidity() && ADRESSE.test(felt.value)
				? ""
				: "Skriv hele e-postadressen, for eksempel ola@eksempel.no"
		}

		return felt.checkValidity() ? "" : "Skriv en dato som finnes"
	}

	/** Viser eller fjerner feilmeldingen for ett felt. */
	function vis(felt: HTMLInputElement, melding: string) {
		const feiltekst = flate?.getElementById(`${felt.id}-feil`)
		if (feiltekst) {
			feiltekst.textContent = melding
			feiltekst.hidden = melding === ""
		}

		const beskrevetAv = (felt.getAttribute("aria-describedby") ?? "")
			.split(/\s+/)
			.filter((id) => id && id !== `${felt.id}-feil`)

		if (melding) {
			felt.setAttribute("aria-invalid", "true")
			felt.dataset.state = "invalid"
			beskrevetAv.push(`${felt.id}-feil`)
		} else {
			felt.removeAttribute("aria-invalid")
			delete felt.dataset.state
		}

		// Feilmeldingen skal ut av aria-describedby igjen når feltet blir
		// gyldig. Ellers peker feltet på en tekst som ikke står på skjermen.
		if (beskrevetAv.length > 0) {
			felt.setAttribute("aria-describedby", beskrevetAv.join(" "))
		} else {
			felt.removeAttribute("aria-describedby")
		}
	}

	/**
	 * Bygger oppsummeringen av det som faktisk står i skjemaet nå.
	 *
	 * Den leses ut av feltene, ikke ført som en egen liste ved siden av.
	 * Retter du én av to feil, er det den gjenværende som står igjen, og
	 * overskriften teller riktig.
	 */
	function oppsummer() {
		const feil = felter
			.filter((felt) => felt.getAttribute("aria-invalid") === "true")
			.map((felt) => ({
				id: felt.id,
				melding: flate?.getElementById(`${felt.id}-feil`)?.textContent ?? "",
			}))

		const liste = oppsummering?.querySelector("ul")
		if (liste) {
			liste.innerHTML = feil
				.map((f) => `<li><a href="#${f.id}">${f.melding}</a></li>`)
				.join("")
		}

		// Overskriften og hidden skrives her, slik en server ville gjort det.
		// Komponenten lager ingen markup: gjorde den det, ville en morfing i
		// Datastar fjernet den igjen. Se «Markup og oppførsel».
		const tittel = oppsummering?.querySelector(".fs-error-summary__title")

		if (oppsummering) oppsummering.hidden = feil.length === 0

		// Står lista tom, blir overskriften urørt. «Skjemaet har 0 feil» ville
		// vært det siste som ble lest opp.
		if (feil.length > 0 && tittel) {
			tittel.textContent =
				feil.length === 1
					? "Skjemaet har én feil"
					: `Skjemaet har ${feil.length} feil`
		}

		return feil.length
	}

	for (const felt of felter) {
		// Mens brukeren skriver sier vi ingenting nytt, men en feilmelding som
		// alt står der forsvinner i det feltet blir riktig.
		felt.addEventListener("input", () => {
			rort.add(felt)

			if (felt.getAttribute("aria-invalid") === "true") {
				vis(felt, meldingFor(felt))
				oppsummer()
			}
		})

		// Når feltet forlates er brukeren ferdig med det, og da er en
		// feilmelding en hjelp og ikke en avbrytelse.
		felt.addEventListener("blur", () => {
			if (!rort.has(felt) && !forsokt) return

			vis(felt, meldingFor(felt))
			oppsummer()
		})
	}

	skjema?.addEventListener("submit", (hendelse) => {
		hendelse.preventDefault()
		forsokt = true

		for (const felt of felter) vis(felt, meldingFor(felt))

		const antall = oppsummer()

		if (status) {
			status.textContent = antall === 0 ? "Søknaden er sendt." : ""
		}
	})
</script>
