{
  "name": "fristil-vscode",
  "displayName": "Fristil",
  "description": "Fullføring, forklaringer og snippets for <fs-*>-elementene i Fristil-designsystemet.",
  "version": "0.1.0",
  "publisher": "fristil",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/MarkusAugust/fristil.git",
    "directory": "editor"
  },
  "homepage": "https://fristil.netlify.app/",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Snippets",
    "Other"
  ],
  "keywords": [
    "fristil",
    "designsystem",
    "web-components",
    "html"
  ],
  "contributes": {
    "html": {
      "customData": [
        "./fristil.html-data.json"
      ]
    },
    "snippets": [
      {
        "language": "html",
        "path": "./snippets.json"
      }
    ]
  },
  "scripts": {
    "generate": "bun scripts/generate.ts",
    "sjekk": "bun scripts/sjekk.ts && vsce package --no-dependencies --out fristil.vsix",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@fristil/designsystem": "workspace:*",
    "@types/node": "24.12.4",
    "@vscode/vsce": "^3.6.0"
  }
}
