{
  // Biome formats and lints. It has the last word in this repository, and
  // `bun run lint` runs exactly the same.
  "biome.enabled": true,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always",
    "source.fixAll.biome": "always"
  },

  // The MDX language server is off. Turn it back on if you want help in the
  // documentation pages; nothing needs it to build.
  "mdx.server.enable": false
}
