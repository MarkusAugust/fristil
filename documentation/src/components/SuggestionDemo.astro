---
import { lt } from "@lo-tek/interfaces"
import Preview from "./Preview.astro"

// The key is the city's code: it gives each option a fixed id, so an
// update from the server recognises the option.
const cities = [
  { code: "abd", name: "Aberdeen" },
  { code: "bel", name: "Belfast" },
  { code: "bol", name: "Bolton" },
  { code: "bou", name: "Bournemouth" },
  { code: "car", name: "Cardiff" },
  { code: "yor", name: "York" },
]

// The server writes the field and the list. The component filters and handles the keyboard.
const suggestion = lt.suggestion({
  id: "demo-city",
  keys: cities.map((k) => k.code),
  help: true,
})
---

<Preview id="demo-suggestion" styles={["suggestion", "label", "input", "help-text", "sr-only"]} maxWidth="30rem">
	<lt-suggestion>
		<label {...suggestion.label}>City</label>
		<input {...suggestion.control} name="city" placeholder="Start typing" />
		<ul {...suggestion.list}>
			{suggestion.options.map((option, i) => <li {...option}>{cities[i].name}</li>)}
		</ul>
		<p {...suggestion.empty}>No matches</p>
		<span {...suggestion.status}></span>
		<p class="lt-help-text" {...suggestion.help}>We fill in the rest of the address for you.</p>
	</lt-suggestion>
</Preview>

<script>
	import { defineLtSuggestion } from "@lo-tek/interfaces/suggestion"

	defineLtSuggestion()
</script>
