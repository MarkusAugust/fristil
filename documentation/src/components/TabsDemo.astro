---
import { fs } from "@fristil/designsystem"
import Preview from "./Preview.astro"

// Markupen serveren sender: lenkene, id-ene på panelene og overskriftene, og
// klassene. Rollene, tabbestoppene og hvilke paneler som er skjult skriver
// komponenten, slik at siden er en innholdsfortegnelse uten JavaScript.
const faner = fs.tabs({
  id: "demo",
  keys: ["soknaden", "vedlegg", "meldinger"],
  label: "Deler av saken",
})
const titler = ["Søknaden", "Vedlegg", "Meldinger"]
const innhold = [
  "Søknaden ble sendt 4. mars 2026. Saksnummer 2026-0481.",
  "Tre vedlegg er lastet opp. Siste kom 6. mars.",
  "Ingen meldinger i denne saken ennå.",
]
---

<Preview id="demo-tabs" stiler={["tabs", "paragraph"]} maxWidth="34rem">
	<fs-tabs>
		<ul {...faner.list}>
			{faner.tabs.map((fane, i) => <li><a {...fane}>{titler[i]}</a></li>)}
		</ul>

		{
			faner.panels.map((panel, i) => (
				<section {...panel}>
					<h3 {...faner.headings[i]}>{titler[i]}</h3>
					<p class="fs-paragraph">{innhold[i]}</p>
				</section>
			))
		}
	</fs-tabs>
</Preview>

<script>
	import { defineFsTabs } from "@fristil/designsystem/tabs"

	defineFsTabs()
</script>
