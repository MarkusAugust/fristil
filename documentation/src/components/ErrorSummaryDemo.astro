---
import { lt } from "@lo-tek/interfaces"
import Preview from "./Preview.astro"

// The server writes the whole box: the class, the role, the tab stop and
// the heading. The component only moves focus and handles clicks on the links.
const feil = lt.errorSummary({ count: 2, id: "demo-oppsummering" })
---

<Preview
	id="demo-error-summary"
	styles={["error-summary", "list", "label", "input", "button", "error-text"]}
	layout="stack"
	maxWidth="34rem"
>
	<form id="demo-form" novalidate>
		<lt-error-summary {...feil.host} data-autofocus="false">
			<h2 {...feil.title}>The form has two errors</h2>
			<ul class="lt-list">
				<li><a href="#demo-email">Enter an email address with an @ sign</a></li>
				<li><a href="#demo-date">Enter the date as day, month and year</a></li>
			</ul>
		</lt-error-summary>

		<label class="lt-label" for="demo-email">Email address</label>
		<input class="lt-input" id="demo-email" type="email" value="jo.example" data-state="invalid" aria-invalid="true" />

		<label class="lt-label" for="demo-date">Date of birth</label>
		<input class="lt-input" id="demo-date" type="date" data-state="invalid" aria-invalid="true" />
	</form>
</Preview>

<script>
	import { defineLtErrorSummary } from "@lo-tek/interfaces/error-summary"

	defineLtErrorSummary()
</script>
