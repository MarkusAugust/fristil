@model Soknad
@* Razor. Skrivefeilen med vilje er data-color="red" på merket. *@
<form asp-action="Send" method="post" novalidate>
  <lt-field>
    <label class="lt-label" data-required="text" asp-for="Epost">E-postadresse</label>
    <input class="lt-input" asp-for="Epost" type="email">
    <span class="lt-error-text" asp-validation-for="Epost">Skriv en gyldig adresse.</span>
  </lt-field>
  @if (Model.Utkast)
  {
    <span class="lt-badge" data-color="warning">Utkast</span>
  }
  <span class="lt-badge" data-color="red">Feil farge</span>
  <button class="lt-button" data-variant="@(Model.Utkast ? "secondary" : null)" type="submit">Send</button>
</form>
