---
import pkg from "../../../interfaces/package.json" with { type: "json" }

/*
 * The version is read from the package when the site is built, so the badge
 * follows `prepare-version` without anyone remembering it. The badge sits
 * next to the logo link and not inside it: a link inside a link is invalid
 * HTML. The name starts with the visible text, so someone using voice control
 * who says "v0.30.0" hits the link.
 */
const { version } = pkg
---

<a
  href="/changelog/"
  class="version-badge"
  aria-label={`v${version}, changelog`}
  translate="no"
>v{version}</a>

<style>
  /* A stamped value in a register: the data face, a rule around it, no corners. */
  .version-badge {
    display: inline-flex;
    align-items: center;
    padding: 0 var(--lt-spacing-2);
    border: var(--lt-spacing-px) solid var(--lt-color-neutral-border);
    font-family: var(--profile-font-data, ui-monospace, monospace);
    font-size: var(--lt-font-size-xxs);
    line-height: 1.8;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--lt-color-neutral-text-subtle);
    text-decoration: none;
    white-space: nowrap;
    transition: color 120ms, border-color 120ms;
  }

  .version-badge:hover {
    color: var(--lt-color-neutral-text-strong);
    border-color: var(--lt-color-accent-fill);
  }

  .version-badge:focus-visible {
    color: var(--lt-color-neutral-text-strong);
    outline: var(--lt-focus-ring, 2px solid var(--lt-color-accent-fill));
    outline-offset: 2px;
  }
</style>
