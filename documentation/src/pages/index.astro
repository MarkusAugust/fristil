---
import "@lo-tek/interfaces/tokens.css"
import "@lo-tek/interfaces/button.css"
import "@lo-tek/interfaces/tag.css"
import "@lo-tek/interfaces/sr-only.css"
import "../styles/profile.css"
import pkg from "../../../interfaces/package.json" with { type: "json" }
import sobernetics from "../assets/sobernetics.svg?raw"
import Film from "../components/Film.astro"
import FontPreload from "../components/FontPreload.astro"
import Logo from "../components/Logo.astro"
import Plate from "../components/Plate.astro"
import VersionBadge from "../components/VersionBadge.astro"
import { metaAttributes, SHARE_IMAGE } from "../share-image.mjs"

const title = "LO-TEK Interfaces"
const description =
  "A framework-independent design system where the components are CSS classes and web components. The same API in React, Astro, Datastar and plain HTML."

// The film on YouTube, the part after `v=` or `youtu.be/` in its address.
const FILM_ID = "35LsWor1EY8"

/*
 * The categories, as a ladder of nodes the way sobernetics.no draws its
 * projects. The text is the same as on the introduction page; here it is
 * short.
 */
const CATEGORIES = [
  {
    name: "css",
    what: "A class on a plain HTML element. No JavaScript is loaded, and variants are set with data attributes. A button costs one class.",
    code: '<button class="lt-button">',
    examples: ["Button", "Field", "Table", "Card"],
  },
  {
    name: "frame",
    what: "You write the HTML. The web component fills in the wiring where it is missing, adds keyboard handling and focus, and leaves the elements in the plain DOM.",
    code: "<lt-field>…</lt-field>",
    examples: ["Field", "Tabs", "Dialog", "Suggestion"],
  },
  {
    name: "standalone",
    what: "The web component creates all of its content itself, because there is nothing for the server to send. A server that is gone cannot report it.",
    code: "<lt-connection-status>",
    examples: ["Connection status", "Toast"],
  },
]

// The three lines the firm signs, above the facts in the register.
const GRADE = [
  "Reads on any screen.",
  "Survives any patch.",
  "Says when it’s broken.",
]
---

<!DOCTYPE html>
<!-- The page is always dark. `data-theme` gives both LO-TEK's dark tokens and
     `color-scheme: dark`, which is what the scrollbar and the browser's own
     surfaces read. The front page is a poster: the wordmark, the light and
     the deep surface are drawn for each other, and a light version would be
     another poster. Every other page follows the reader. -->
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <FontPreload />
  <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <!-- The front page sits outside Starlight, so the tags for shared links,
       which Starlight writes on the other pages, are here. -->
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={Astro.site?.href} />
  <meta property="og:locale" content="en" />
  <meta property="og:site_name" content="LO-TEK Interfaces" />
  <meta name="twitter:card" content="summary_large_image" />
  {SHARE_IMAGE.map((tag) => {
    const { property, name, content } = metaAttributes(tag)
    return <meta property={property} name={name} content={content} />
  })}
</head>
<body class="profile-grain">
  <a class="skip lt-sr-only" href="#content">Skip to content</a>

  <div class="sheet">
    <header class="top">
      <div class="top__mark">
        <a href="/" class="top__home" aria-label="LO-TEK Interfaces, front page">
          <Logo size="sm" />
        </a>
        <VersionBadge />
      </div>
      <nav class="top__nav" aria-label="Main">
        <ul>
          <li><a href="/introduction/">Documentation</a></li>
          <li><a href="/components/">Components</a></li>
          <li><a href="/llms.txt">llms.txt</a></li>
          <li><a href="https://github.com/MarkusAugust/lo-tek" rel="noreferrer">GitHub</a></li>
        </ul>
      </nav>
    </header>

    <main id="content">
      <!-- The masthead: the name, the line, the register and the plate. -->
      <section class="masthead" aria-labelledby="name">
        <div class="masthead__text">
          <h1 id="name" class="masthead__name">
            <Logo size="lg" subtitle={false} />
          </h1>
          <p class="masthead__line">
            A framework-independent design system. The components are CSS
            classes and web components, things the browser already
            understands. Whether the team uses React, Astro, Datastar or plain
            HTML, it is the same system and the same API.
          </p>
          <p class="masthead__line masthead__line--second">
            A design system tied to one framework has to be rewritten when the
            framework is replaced. The browser's own APIs are not replaced.
          </p>

          <div class="masthead__register">
            <p class="profile-label" id="grade">LO-TEK grade</p>
            <ol class="grade" aria-labelledby="grade">
              {GRADE.map((line, i) => (
                <li><span class="grade__index" aria-hidden="true">0{i + 1}</span>{line}</li>
              ))}
            </ol>

            <dl class="profile-register-list">
              <dt>Package</dt>
              <dd><code>{pkg.name}</code></dd>
              <dt>Status</dt>
              <dd>Before 1.0. Breaking changes are in the changelog.</dd>
              <dt>Licence</dt>
              <dd>MIT</dd>
              <dt>Source</dt>
              <dd><a class="masthead__link" href="https://github.com/MarkusAugust/lo-tek">github.com/MarkusAugust/lo-tek</a></dd>
            </dl>
          </div>

          <div class="masthead__actions">
            <a href="/getting-started/" class="lt-button">Get started</a>
            <a href="/components/" class="lt-button" data-variant="secondary">See the components</a>
          </div>
        </div>

        <div class="masthead__plate">
          <Plate />
        </div>
      </section>

      <span class="profile-register" aria-hidden="true"></span>

      <!-- The epigraph. It is attributed, so it is a blockquote with a source. -->
      <figure class="epigraph">
        <blockquote class="epigraph__words">
          <p>The Halcyon board asked Trace what it runs on.</p>
          <p>“Whatever sends the page. Whatever shows it. Nothing in between.”</p>
          <p>“So it needs a framework?”</p>
          <p>“It doesn’t need anything. Bring yours.”</p>
        </blockquote>
        <figcaption class="epigraph__source">
          Trace, LO-TEK Interfaces
        </figcaption>
      </figure>

      <!-- The architecture: three categories, drawn as a ladder of nodes. -->
      <div class="profile-plate">
        <h2 class="profile-plate__title" id="architecture">Architecture</h2>
        <p class="profile-plate__count" aria-hidden="true">03 categories</p>
      </div>

      <ol class="ladder" aria-labelledby="architecture">
        {CATEGORIES.map((category, i) => (
          <li class="node">
            <p class="node__index" aria-hidden="true">0{i + 1}</p>
            <h3 class="node__name profile-name">{category.name}</h3>
            <p class="node__what">{category.what}</p>
            <code class="node__code" tabindex="0">{category.code}</code>
            <ul class="node__examples" aria-label="Examples">
              {category.examples.map((example) => (
                <li class="lt-tag">{example}</li>
              ))}
            </ul>
          </li>
        ))}
      </ol>

      <p class="ladder__after">
        The whole reasoning, and the answer to when you use the builder
        function rather than the web component, is in
        <a class="masthead__link" href="/markup-and-behaviour/">Markup and behaviour</a>.
      </p>

      <!-- What you do not have to solve yourself. -->
      <div class="profile-plate">
        <h2 class="profile-plate__title" id="strengths">What you do not have to solve yourself</h2>
        <p class="profile-plate__count" aria-hidden="true">04 points</p>
      </div>

      <ol class="ladder ladder--prose" aria-labelledby="strengths">
        <li class="node">
          <p class="node__index" aria-hidden="true">01</p>
          <h3 class="node__title">The editor knows the components</h3>
          <p class="node__what">
            Write <code>data-variant="secundary"</code> by hand and nothing
            happens: the button keeps the default style, and the browser says
            nothing. Write it through the function and you get an error in the
            editor before you can save.
          </p>
          <pre class="node__pre" tabindex="0"><code>&lt;button
  &#123;...lt.button(&#123;
    variant: "secondary",
  &#125;)&#125;
&gt;
  Save draft
&lt;/button&gt;</code></pre>
          <p class="node__what">
            The function returns a plain object of attributes, so the same call
            works in JSX, in an Astro template and in plain JavaScript. If you
            write HTML without TypeScript, <a class="masthead__link" href="/the-editor/">the VS Code extension</a>
            does the same, and JetBrains gets completion from the package itself.
          </p>
        </li>

        <li class="node">
          <p class="node__index" aria-hidden="true">02</p>
          <h3 class="node__title">Your CSS beats ours</h3>
          <p class="node__what">
            All our CSS sits in its own cascade layer. An ordinary rule in your
            own CSS then beats ours, however specific ours is, and without
            <code>!important</code>. If you only want to change shape or size,
            there is a variable per component.
          </p>
          <pre class="node__pre" tabindex="0"><code>:root &#123;
  --lt-button-radius: 9999px;
&#125;</code></pre>
          <p class="node__what">
            The tests open a browser and check that your rule actually wins,
            that the variable comes through, and that a Tailwind utility beats
            the component's own value.
          </p>
        </li>

        <li class="node">
          <p class="node__index" aria-hidden="true">03</p>
          <h3 class="node__title">The colours meet the contrast requirement</h3>
          <p class="node__what">
            Every colour pair in the system is computed and checked against the
            WCAG requirement, in both light and dark themes. If you give your
            own brand colours, their families are computed afresh with
            <code>buildTheme</code>.
          </p>
          <pre class="node__pre" tabindex="0"><code>const theme = buildTheme(&#123;
  accent: "#0062ba",
&#125;)

// theme.violations is empty
// when the contrast holds</code></pre>
          <p class="node__what">
            The colours are computed in OKLCH, because lightness in HSL means
            something different for each hue. The brand colour gives the hue,
            while the role sets the lightness and how much of the chroma is
            kept. Every page here is run through axe in both themes.
          </p>
        </li>

        <li class="node">
          <p class="node__index" aria-hidden="true">04</p>
          <h3 class="node__title">The coding agent does not have to guess</h3>
          <p class="node__what">
            An agent that does not know the design system invents
            <code>lt-modal</code>, hard-codes the colours and writes its own CSS
            when the stylesheet is missing. LO-TEK has a rulebook for agents
            per framework, and it ships with the package. When the agent is
            done, the check says what is wrong, with file and line.
          </p>
          <pre class="node__pre" tabindex="0"><code>npx @lo-tek/interfaces check form.html

form.html:3:13: warning: The class "lt-modal"
  does not exist in LO-TEK.</code></pre>
          <p class="node__what">
            The whole documentation also exists as Markdown, made from the same
            pages you are reading now, and <a class="masthead__link" href="/llms.txt">llms.txt</a>
            shows the way. More about the setup under
            <a class="masthead__link" href="/coding-agents/">Coding agents</a>.
          </p>
        </li>
      </ol>

      <!-- The film. The loop from it is the poster, and YouTube is reached
           only when the reader presses play. -->
      <div class="profile-plate">
        <h2 class="profile-plate__title" id="film">The film</h2>
        <p class="profile-plate__count" aria-hidden="true">05:13 runtime</p>
      </div>

      <Film youtubeId={FILM_ID} title="LO-TEK: Nothing In Between">
        <b>LO-TEK: Nothing In Between.</b> One unbroken flight inwards
        through a machine drawn in white ink on dark paper, from a tower in
        the rain down through server halls, circuit boards, hard drives and a
        picture tube to single atoms. The machines come apart in time with
        the music, and the film ends on a small screen with a page that is
        still loading. With English captions.
      </Film>
    </main>

    <footer class="colophon">
      <p>
        &copy; 2026 August Søberg-Klyver. LO-TEK is a framework-independent
        design system, released under the MIT licence.
      </p>
      <a class="sobernetics" href="https://sobernetics.no"><Fragment set:html={sobernetics} /></a>
    </footer>
  </div>
</body>
</html>

<style>
  /*
   * The page is a printed sheet with margins, not a hero section. The colours
   * come from tokens, and the only thing written in is the geometry.
   */
  html {
    background: var(--lt-color-neutral-canvas);
    -webkit-text-size-adjust: 100%;
  }

  body {
    min-block-size: 100dvh;
    margin: 0;
    /* The surface has to be on the body as well as on html: the grain blends
       inside the body's isolated group, and a transparent body would leave
       it nothing to blend with. */
    background: var(--lt-color-neutral-canvas);
    color: var(--lt-color-neutral-text);
    /* The front page is set as a printout, in the data face, as sobernetics.no
       is. It is short. The documentation pages are long, and keep the
       grotesque. */
    font-family: var(--profile-font-data);
    font-size: var(--lt-font-size-s);
    line-height: var(--lt-line-height-default);
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  code {
    font-family: var(--profile-font-data);
    font-size: 0.9em;
  }

  .skip:focus {
    position: fixed;
    inset-block-start: var(--lt-spacing-2);
    inset-inline-start: var(--lt-spacing-2);
    inline-size: auto;
    block-size: auto;
    margin: 0;
    padding: var(--lt-spacing-2) var(--lt-spacing-3);
    clip: auto;
    clip-path: none;
    overflow: visible;
    white-space: normal;
    background: var(--lt-color-neutral-text-strong);
    color: var(--lt-color-neutral-canvas);
    font-family: var(--profile-font-data);
    outline: var(--lt-focus-ring, 2px solid var(--lt-color-accent-fill));
    outline-offset: 2px;
    z-index: 10;
  }

  .sheet {
    container-type: inline-size;
    max-inline-size: 72rem;
    margin-inline: auto;
    padding: var(--lt-spacing-5) var(--lt-spacing-5) var(--lt-spacing-12);
  }

  @media (min-width: 48rem) {
    .sheet {
      padding: var(--lt-spacing-8) var(--lt-spacing-10) var(--lt-spacing-16);
    }
  }

  /*
   * Crop marks in the corners of the sheet, as on a printed sheet before it is
   * trimmed. Each corner is two short hairlines, drawn as backgrounds so they
   * take no element and nothing for a screen reader. They sit in the margin,
   * outside the text.
   */
  .sheet {
    --crop: var(--lt-color-neutral-border-strong);
    --crop-length: 1.25rem;
    --crop-inset: var(--lt-spacing-2);
    background:
      linear-gradient(var(--crop), var(--crop)) left var(--crop-inset) top var(--crop-inset) / var(--crop-length) 1px,
      linear-gradient(var(--crop), var(--crop)) left var(--crop-inset) top var(--crop-inset) / 1px var(--crop-length),
      linear-gradient(var(--crop), var(--crop)) right var(--crop-inset) top var(--crop-inset) / var(--crop-length) 1px,
      linear-gradient(var(--crop), var(--crop)) right var(--crop-inset) top var(--crop-inset) / 1px var(--crop-length),
      linear-gradient(var(--crop), var(--crop)) left var(--crop-inset) bottom var(--crop-inset) / var(--crop-length) 1px,
      linear-gradient(var(--crop), var(--crop)) left var(--crop-inset) bottom var(--crop-inset) / 1px var(--crop-length),
      linear-gradient(var(--crop), var(--crop)) right var(--crop-inset) bottom var(--crop-inset) / var(--crop-length) 1px,
      linear-gradient(var(--crop), var(--crop)) right var(--crop-inset) bottom var(--crop-inset) / 1px var(--crop-length);
    background-repeat: no-repeat;
  }

  /* The top: the mark on the left, the menu on the right, a rule below. */
  .top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--lt-spacing-3) var(--lt-spacing-6);
    padding-block-end: var(--lt-spacing-4);
    border-block-end: var(--profile-rule);
  }

  .top__mark {
    display: inline-flex;
    align-items: center;
    gap: var(--lt-spacing-4);
  }

  .top__home {
    color: var(--lt-color-neutral-text-strong);
    text-decoration: none;
  }

  .top__nav ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--lt-spacing-2) var(--lt-spacing-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .top__nav a {
    font-family: var(--profile-font-data);
    font-size: var(--lt-font-size-xs);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--lt-color-neutral-text);
    text-decoration: none;
  }

  .top__nav a:hover {
    color: var(--lt-color-neutral-text-strong);
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .top__home:focus-visible,
  .top__nav a:focus-visible,
  .masthead__link:focus-visible,
  .node__code:focus-visible,
  .node__pre:focus-visible,
  .sobernetics:focus-visible {
    outline: var(--lt-focus-ring, 2px solid var(--lt-color-accent-fill));
    outline-offset: var(--lt-spacing-1);
  }

  /* The masthead. The text on the left, the plate on the right from 64rem. */
  .masthead {
    display: grid;
    gap: var(--lt-spacing-10);
    padding-block: var(--lt-spacing-10) var(--lt-spacing-8);
  }

  @media (min-width: 64rem) {
    .masthead {
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 0.9fr);
      align-items: start;
      padding-block: var(--lt-spacing-14, 3.5rem) var(--lt-spacing-10);
    }
  }

  .masthead__text {
    container-type: inline-size;
    min-inline-size: 0;
  }

  .masthead__name {
    margin: 0;
    color: var(--lt-color-neutral-text-strong);
  }

  .masthead__line {
    max-inline-size: 38rem;
    margin: var(--lt-spacing-6) 0 0;
    font-size: var(--lt-font-size-m);
    line-height: var(--lt-line-height-article);
    color: var(--lt-color-neutral-text);
    text-wrap: pretty;
  }

  .masthead__line--second {
    margin-block-start: var(--lt-spacing-4);
    color: var(--lt-color-neutral-text-subtle);
  }

  .masthead__register {
    margin-block-start: var(--lt-spacing-6);
  }

  /* The grade: three numbered lines in the data face, above the facts. */
  .grade {
    margin: var(--lt-spacing-2) 0 var(--lt-spacing-4);
    padding: 0 0 var(--lt-spacing-4);
    list-style: none;
    border-block-end: var(--profile-rule-subtle);
    font-family: var(--profile-font-data);
    font-size: var(--lt-font-size-xs);
    color: var(--lt-color-neutral-text-strong);
  }

  .grade li + li {
    margin-block-start: var(--lt-spacing-1);
  }

  .grade__index {
    display: inline-block;
    min-inline-size: 2.5em;
    font-variant-numeric: tabular-nums;
    color: var(--lt-color-accent-text);
  }

  .masthead__link {
    color: var(--lt-color-accent-text);
    text-decoration: underline;
    text-decoration-thickness: 0.06em;
    text-underline-offset: 0.14em;
  }

  .masthead__link:hover {
    color: var(--lt-color-accent-text-strong);
  }

  .masthead__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--lt-spacing-3);
    margin-block-start: var(--lt-spacing-8);
  }

  /* The buttons are LO-TEK's own, but here without rounded corners, like everything else. */
  .masthead__actions .lt-button {
    --lt-button-radius: 0;
    text-decoration: none;
  }

  .masthead__plate {
    min-inline-size: 0;
  }

  /* The epigraph: an excerpt with a rule on the left, set a little narrower. */
  .epigraph {
    margin: var(--lt-spacing-10) 0 0;
    max-inline-size: 44rem;
  }

  .epigraph__words {
    margin: 0;
    padding-inline-start: var(--lt-spacing-5);
    border-inline-start: var(--lt-spacing-0-5) solid var(--lt-color-accent-fill);
  }

  .epigraph__words p {
    margin: 0;
    font-size: var(--lt-font-size-s);
    line-height: var(--lt-line-height-article);
    color: var(--lt-color-neutral-text);
    text-wrap: pretty;
  }

  .epigraph__words p + p {
    margin-block-start: var(--lt-spacing-3);
  }

  .epigraph__source {
    margin: var(--lt-spacing-3) 0 0 var(--lt-spacing-5);
    padding-inline-start: var(--lt-spacing-0-5);
    font-family: var(--profile-font-data);
    font-size: var(--lt-font-size-xs);
    letter-spacing: 0.04em;
    color: var(--lt-color-neutral-text-subtle);
  }

  /* The plates have space above them, and the list right below. */
  .profile-plate {
    margin-block-start: var(--lt-spacing-16);
  }

  /* The ladder: a numbered list drawn as nodes with a rule between. */
  .ladder {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .node {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr);
    grid-template-areas:
      "index name"
      ".     what"
      ".     code"
      ".     examples";
    column-gap: var(--lt-spacing-4);
    padding-block: var(--lt-spacing-6);
    border-block-end: var(--profile-rule);
  }

  @media (min-width: 48rem) {
    .node {
      grid-template-columns: 5rem minmax(0, 1fr);
    }
  }

  .node__index {
    grid-area: index;
    margin: 0;
    padding-block-start: 0.35em;
    font-family: var(--profile-font-data);
    font-size: var(--lt-font-size-xs);
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.1em;
    color: var(--lt-color-neutral-text-subtle);
  }

  .node__name,
  .node__title {
    grid-area: name;
    margin: 0;
    color: var(--lt-color-neutral-text-strong);
  }

  .node__name {
    font-size: clamp(1.1rem, 3.6cqi, 1.75rem);
    line-height: 1.05;
  }

  .node__title {
    font-size: var(--lt-font-size-xl);
    font-weight: 700;
    line-height: var(--lt-line-height-heading);
  }

  .node__what {
    grid-area: what;
    max-inline-size: 60ch;
    margin: var(--lt-spacing-3) 0 0;
    font-size: var(--lt-font-size-s);
    line-height: var(--lt-line-height-article);
    color: var(--lt-color-neutral-text);
    text-wrap: pretty;
  }

  .node__what code {
    color: var(--lt-color-neutral-text-strong);
  }

  .node__code,
  .node__pre {
    grid-area: code;
    display: block;
    max-inline-size: 100%;
    margin: var(--lt-spacing-4) 0 0;
    padding: var(--lt-spacing-2) var(--lt-spacing-3);
    border: var(--profile-rule-subtle);
    border-inline-start: var(--lt-spacing-0-5) solid var(--lt-color-neutral-border);
    background: var(--lt-color-neutral-surface);
    font-family: var(--profile-font-data);
    font-size: var(--lt-font-size-xs);
    line-height: 1.6;
    color: var(--lt-color-neutral-text-strong);
    overflow-x: auto;
  }

  .node__pre {
    max-inline-size: 36rem;
    padding: var(--lt-spacing-3) var(--lt-spacing-4);
  }

  .node__pre code {
    font-size: inherit;
  }

  /* In the list of prose a node has a paragraph after the code, and no
     examples, so the fourth area is the paragraph's. */
  .ladder--prose .node {
    grid-template-areas:
      "index name"
      ".     what"
      ".     code"
      ".     after";
  }

  .ladder--prose .node__what + .node__pre + .node__what {
    grid-area: after;
  }

  .node__examples {
    grid-area: examples;
    display: flex;
    flex-wrap: wrap;
    gap: var(--lt-spacing-2);
    margin: var(--lt-spacing-4) 0 0;
    padding: 0;
    list-style: none;
  }

  .ladder__after {
    max-inline-size: 60ch;
    margin: var(--lt-spacing-5) 0 0;
    font-size: var(--lt-font-size-s);
    line-height: var(--lt-line-height-article);
    color: var(--lt-color-neutral-text-subtle);
  }

  @media (min-width: 48rem) {
    .ladder__after {
      padding-inline-start: calc(5rem + var(--lt-spacing-4));
    }
  }

  /* The colophon. It has no rule of its own: the last node's rule above it
     already closes the sheet, and a second one read as a double line. */
  .colophon {
    margin-block-start: var(--lt-spacing-12);
    max-inline-size: 44ch;
    font-size: var(--lt-font-size-s);
    color: var(--lt-color-neutral-text-subtle);
  }

  .colophon p {
    margin: 0;
    text-wrap: pretty;
  }

  @media (prefers-contrast: more) {
    .top__nav a,
    .masthead__link {
      text-decoration: underline;
    }
  }

  /* Paper takes the light theme, which the script at the foot of the page
     switches to for the print. */
  @media print {
    .sheet {
      max-inline-size: none;
      padding: 0;
    }
  }
</style>

<script>
  /*
   * The page is always dark on screen, but a printer drops the backgrounds,
   * and the dark theme's light text would stand nearly invisible on white
   * paper. A colour written into a print rule only reaches the elements that
   * do not set their own, and nearly all of them do, from the tokens. So the
   * print switches the whole page to the light tokens, as a sheet of paper
   * would be, and back afterwards.
   */
  const root = document.documentElement
  addEventListener("beforeprint", () => {
    root.dataset.theme = "light"
  })
  addEventListener("afterprint", () => {
    root.dataset.theme = "dark"
  })
</script>

<style is:global>
  /* The Søbernetics mark. Small on purpose, and small is the whole of how it
     stays quiet: the opacity it first had took it to 3.5:1 against the
     surface, below the contrast required of a link. Subtlety is size, not a
     washed-out colour.

     The red is Søbernetics' own, set here and not taken from the host's
     accent token: a mark that changes hue per project is not a mark. */
  .sobernetics {
    /* The page is always dark, so the mark takes the dark value outright. */
    --sobernetics-accent: #f44851;
    display: inline-block;
    margin-block-start: var(--lt-spacing-5);
    color: var(--lt-color-neutral-text-subtle);
  }

  .sobernetics:hover,
  .sobernetics:focus-visible {
    color: var(--lt-color-neutral-text-strong);
  }

  .sobernetics svg {
    display: block;
    block-size: 18px;
    inline-size: auto;
  }
</style>
