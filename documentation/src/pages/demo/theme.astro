---
/**
 * The theme picker as a real page, without a line of JavaScript.
 *
 * It has to be its own address and not a preview, because `:root:has()` only
 * sees its own tree. All our previews sit in a shadow root, and a control in
 * there does not set the theme on the page. That has been checked in all three
 * engines, and is stated as a limitation on the pattern page.
 *
 * The page deliberately has no `data-theme` on `<html>`: then "Follow the
 * system" is the machine's own choice, which is what a consumer with no stored
 * choice would get. And it deliberately has no `<script>`: the whole point is
 * that it works without one.
 */

import "@lo-tek/interfaces/tokens.css"
import "@lo-tek/interfaces/toggle-group.css"
import "@lo-tek/interfaces/sr-only.css"
import "@lo-tek/interfaces/button.css"
import "@lo-tek/interfaces/input.css"
import "@lo-tek/interfaces/label.css"
import "@lo-tek/interfaces/help-text.css"
import "@lo-tek/interfaces/heading.css"
import "@lo-tek/interfaces/paragraph.css"
import "@lo-tek/interfaces/card.css"
import "@lo-tek/interfaces/badge.css"

const VALG = [
  { verdi: "auto", tekst: "Follow the system" },
  { verdi: "light", tekst: "Light" },
  { verdi: "dark", tekst: "Dark" },
]
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Theme picker</title>
  </head>
  <body>
    <main class="demo__content">
      <h1 class="lt-heading" data-size="xl">Appearance</h1>
      <p class="lt-paragraph">
        The choice takes effect at once. Nothing on this page runs
        JavaScript.
      </p>

      <div class="demo__form">
        <fieldset class="lt-toggle-group" aria-describedby="demo-theme-switch">
          <legend class="lt-sr-only">Theme</legend>
          {
            VALG.map(({ verdi, tekst }) => (
              <label class="lt-toggle-group__option">
                <input
                  class="lt-theme-control"
                  type="radio"
                  name="theme"
                  value={verdi}
                  checked={verdi === "auto"}
                />
                {tekst}
              </label>
            ))
          }
        </fieldset>
        <p class="lt-help-text" id="demo-theme-switch">
          The switch is pure CSS. Making the choice last is a different job, and
          it is the app's: here there is no server and no storage, so the choice
          holds until you reload the page.
        </p>
      </div>

      <section class="lt-card demo__card">
        <h2 class="lt-heading" data-size="m">
          Grant application
          <span class="lt-badge" data-color="warning">Under review</span>
        </h2>
        <p class="lt-paragraph">
          The surfaces, borders and text all read their colours from the same
          tokens, so they follow the choice without any of them knowing about it.
        </p>
        <label class="lt-label" for="demo-theme-sum">Amount applied for</label>
        <input
          class="lt-input"
          id="demo-theme-sum"
          type="text"
          value="48,000"
          aria-describedby="demo-theme-help"
        />
        <p class="lt-help-text" id="demo-theme-help">
          The browser's own surfaces follow along, because the blocks set
          <code>color-scheme</code>.
        </p>
      </section>
    </main>

    <style>
      /*
       * The page deliberately does not set `color-scheme` itself.
       *
       * The picker does: "Follow the system" sets `light dark`, and a chosen
       * theme sets its own. If the page wrote it here, outside a layer, it
       * would beat `@layer lotek` and lock the browser's surfaces to the
       * system while the user had chosen something else.
       */
      body {
        margin: 0;
        background: var(--lt-color-neutral-canvas);
        color: var(--lt-color-neutral-text-strong);
        font-family:
          system-ui,
          -apple-system,
          "Segoe UI",
          sans-serif;
      }

      .demo__content {
        display: flex;
        flex-direction: column;
        gap: var(--lt-spacing-5);
        padding: var(--lt-spacing-6);
        max-inline-size: 42rem;
        margin-inline: auto;
      }

      .demo__form {
        display: flex;
        flex-direction: column;
        gap: var(--lt-spacing-3);
        align-items: start;
      }

      /*
       * The card fills the width, or it shrinks to its content.
       *
       * And only that: Astro writes this block without a layer, and an
       * unlayered rule beats `@layer lotek`. Had we set `gap` here, the demo
       * would have overridden the card's own spacing, which is exactly what the
       * customising page warns against.
       */
      .demo__card {
        align-self: stretch;
      }
    </style>
  </body>
</html>
