---
import { lt } from "@lo-tek/interfaces"
import Preview from "./Preview.astro"

// Serveren skriver koblingen: aria-controls på knappen, klassen og popover
// på panelet. Komponenten regner ut posisjonen og lukker ved klikk utenfor.
const boks = lt.popover({ id: "demo-popover-panel" })
const handlinger = [
  "Arkiver saken",
  "Last ned som PDF",
  "Del med saksbehandler",
]
---

<Preview id="demo-popover" stiler={["popover", "button"]} maxWidth="30rem">
	<lt-popover placement="bottom-start" {...boks.host}>
		<button {...boks.trigger} {...lt.button({ variant: "secondary" })} type="button">
			Handlinger
		</button>

		<ul {...boks.panel}>
			{
				handlinger.map((tekst) => (
					<li>
						<button class="lt-button" data-variant="ghost" type="button">
							{tekst}
						</button>
					</li>
				))
			}
		</ul>
	</lt-popover>
</Preview>

<script>
	import { defineLtPopover } from "@lo-tek/interfaces/popover"

	defineLtPopover()
</script>
