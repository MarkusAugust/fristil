---
/**
 * The mark and the wordmark.
 *
 * The mark is L and T set tight together, with a shadow cast by the pair.
 * Its colours are fixed and do not follow the theme: a mark that changes with
 * the page is not a mark. The dark edge round the letters and the shadow is
 * what holds it against a light background, so it needs no box behind it.
 * Only the large logo has the mark, with the shadow drawn as scan lines. The
 * header has the name alone. The icon in `public/favicon.svg` fills the
 * shadow, since lines that fine disappear at the size of a tab.
 *
 * The name stands in Michroma, in capitals, the way sobernetics.no sets its
 * own. It comes in one weight, so `font-synthesis: none` stops the browser
 * from making a bold that smears the square curves. The hyphen is in the
 * accent colour: it is the join between the two halves, where the signal
 * goes, as the Ø is on sobernetics.no. The name is type, not part of the
 * mark, so it takes the text colour of the theme.
 */
import { COLOURS, EDGE, INK, SCAN_LINES, VIEW_BOX } from "../mark.mjs"

export interface Props {
  size?: "sm" | "lg"
  className?: string
  /** The word "Interfaces" under the name. The front page says it in the line below, so there it is off. */
  subtitle?: boolean
}

const { size = "sm", className = "", subtitle = true } = Astro.props
---

<span class:list={["logo", `logo--${size}`, className]}>
  {size === "lg" && (
    <svg class="logo__mark" viewBox={VIEW_BOX} xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <path fill={COLOURS.edge} d={EDGE} />
      <path fill={COLOURS.shadow} d={SCAN_LINES} />
      <path fill={COLOURS.ink} d={INK} />
    </svg>
  )}
  <span class="logo__text">
    <span class="logo__name profile-name">LO<span class="logo__join">-</span>TEK</span>
    {subtitle && <span class="logo__subtitle profile-label">Interfaces</span>}
  </span>
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: var(--logo-gap);
    color: inherit;
    line-height: 1;
  }

  .logo--sm {
    --logo-gap: var(--lt-spacing-1-5, 0.375rem);
    --logo-name: 1.25rem;
  }

  .logo--lg {
    --logo-gap: var(--lt-spacing-2);
    /* Sized against the width of the sheet, not the window, so the name never breaks. */
    --logo-mark: clamp(3.5rem, 15cqi, 7rem);
    --logo-name: clamp(2rem, 11cqi, 5rem);
  }

  .logo__mark {
    flex: none;
    inline-size: var(--logo-mark);
    block-size: var(--logo-mark);
  }

  .logo__text {
    display: flex;
    flex-direction: column;
    gap: var(--lt-spacing-1);
  }

  .logo__name {
    font-size: var(--logo-name);
    color: currentColor;
    white-space: nowrap;
  }

  /*
   * Michroma spaces the hyphen evenly between the outlines, but the eye
   * measures it against the stem of the T, not the end of its bar, and saw it
   * pushed towards the O. Pulling the T in until its bar hangs over the
   * hyphen puts the hyphen midway between the O and the stem. The bar and the
   * hyphen are at different heights, so they never touch.
   */
  .logo__join {
    margin-inline-end: -0.3em;
    color: var(--lt-color-accent-fill);
  }

  .logo--lg .logo__subtitle {
    font-size: var(--lt-font-size-xs);
  }
</style>
