{
  "$schema": "https://biomejs.dev/schemas/2.4.16/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!presentation",
      "!interfaces/html-data.json",
      "!interfaces/snippets.json",
      "!interfaces/src/vocabulary/elements.ts",
      "!interfaces/src/vocabulary/classes.ts",
      "!interfaces/src/components/events.ts",
      "!interfaces/src/tokens/matrix-cells.ts",
      "!interfaces/web-types.json",
      "!core/parity",
      "!core/templates",
      "!core/theme",
      "!interfaces/manifest/manifest.json",
      "!interfaces/manifest/files.json",
      "!interfaces/manifest/build-cases.json",
      "!interfaces/src/testing/datastar",
      "!interfaces/src/testing/idiomorph/idiomorph-v0.8.0.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "nursery": {
        "useSortedClasses": "error"
      }
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "arrowParentheses": "always",
      "indentStyle": "space",
      "indentWidth": 2,
      "trailingCommas": "all",
      "semicolons": "asNeeded"
    }
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedImports": "off",
            "noUnusedVariables": "off"
          }
        }
      }
    }
  ],
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  }
}
