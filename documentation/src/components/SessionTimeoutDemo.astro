---
import Preview from "./Preview.astro"
---

<Preview id="demo-okt" stiler={["session-timeout", "button", "sr-only"]} maxWidth="34rem">
	<p class="lt-paragraph">
		Her er økten satt til fem sekunder, så du slipper å vente i 25 minutter.
		Slutt å røre tastaturet og musa, så kommer varselet.
	</p>
	<lt-session-timeout
		class="lt-session-timeout"
		warn-at="5"
		expires-at="65"
		data-ignore-morph>
		<dialog class="lt-session-timeout__dialog" role="alertdialog" aria-labelledby="demo-okt-tittel">
			<h2 class="lt-session-timeout__title" id="demo-okt-tittel">Du blir snart logget ut</h2>
			<p class="lt-session-timeout__text">
				Vi logger deg ut om <span class="lt-session-timeout__count" aria-hidden="true"></span>
				for å beskytte opplysningene dine.
			</p>
			<span class="lt-sr-only" role="status"></span>
			<form method="dialog" class="lt-session-timeout__actions">
				<button class="lt-button" value="extend">Fortsett å være innlogget</button>
				<button class="lt-button" data-variant="secondary" value="logout">Logg ut nå</button>
			</form>
		</dialog>
	</lt-session-timeout>
</Preview>

<script>
	import { defineLtSessionTimeout } from "@lo-tek/interfaces/session-timeout"

	defineLtSessionTimeout()
</script>
