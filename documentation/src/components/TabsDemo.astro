---
import { lt } from "@lo-tek/interfaces"
import Preview from "./Preview.astro"

// The markup the server sends: the links, the ids on the panels and headings,
// and the classes. The roles, the tab stops and which panels are hidden are
// written by the component, so without JavaScript the page is a table of
// contents.
const tabSet = lt.tabs({
  id: "demo",
  keys: ["application", "attachments", "messages"],
  label: "Parts of the case",
})
const titles = ["Application", "Attachments", "Messages"]
const contents = [
  "The application was sent on 4 March 2026. Case number 2026-0481.",
  "Three attachments have been uploaded. The last one arrived on 6 March.",
  "No messages in this case yet.",
]
---

<Preview id="demo-tabs" styles={["tabs", "paragraph"]} maxWidth="34rem">
	<lt-tabs>
		<ul {...tabSet.list}>
			{tabSet.tabs.map((tab, i) => <li><a {...tab}>{titles[i]}</a></li>)}
		</ul>

		{
			tabSet.panels.map((panel, i) => (
				<section {...panel}>
					<h3 {...tabSet.headings[i]}>{titles[i]}</h3>
					<p class="lt-paragraph">{contents[i]}</p>
				</section>
			))
		}
	</lt-tabs>
</Preview>

<script>
	import { defineLtTabs } from "@lo-tek/interfaces/tabs"

	defineLtTabs()
</script>
