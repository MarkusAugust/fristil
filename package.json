{
  "name": "lo-tek-monorepo",
  "private": true,
  "workspaces": [
    "interfaces",
    "documentation",
    "vscode"
  ],
  "scripts": {
    "dev": "bun --filter @lo-tek/documentation dev",
    "build": "bun --filter @lo-tek/interfaces build && bun --filter ./vscode check && bun --filter @lo-tek/documentation build",
    "typecheck": "tsc -b && bun --filter @lo-tek/interfaces typecheck:scripts && bun --filter ./vscode typecheck",
    "typecheck:tests": "bun --filter @lo-tek/interfaces typecheck:tests",
    "test": "bun --filter @lo-tek/interfaces test:browser && bun --filter @lo-tek/interfaces check:without-javascript && bun --filter @lo-tek/interfaces check:tailwind",
    "test:docs": "bun --filter @lo-tek/documentation test:docs",
    "lint": "biome check .",
    "prepare-version": "bun interfaces/scripts/prepare-version.ts",
    "tag": "bun interfaces/scripts/tag.ts",
    "check": "bun scripts/check.ts",
    "check:authors": "bun interfaces/scripts/check-authors.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
