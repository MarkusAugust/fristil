---
import Logo from "./Logo.astro"
import VersionBadge from "./VersionBadge.astro"

const { siteTitleHref } = Astro.locals.starlightRoute
---

<div class="inline-flex items-center gap-6">
	<a href={siteTitleHref} class="site-title inline-flex items-center no-underline text-inherit">
		<Logo size="sm" />
	</a>
	<VersionBadge />
</div>
