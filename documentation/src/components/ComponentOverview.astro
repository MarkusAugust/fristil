---
/**
 * The overview of every component, read from what exists.
 *
 * Nothing here is written by hand. The title and description come from the
 * frontmatter of each component page, and the category from the folder the
 * component sits in under `interfaces/src/components/`. The list can then
 * neither run empty nor drift from the pages: a new component appears by
 * itself, and a description changed here is the same one as on the page.
 *
 * The sources are loaded with `import.meta.glob`, which Vite resolves at build
 * time. A path computed from `import.meta.url` would have pointed at the chunk
 * after bundling, not at the source, as `llms.txt.ts` explains in the same place.
 */

import { getCollection } from "astro:content"

/*
 * The folder name of each component, with the category it sits under.
 *
 * Without `eager`: we only need the paths, not the modules. Running them would
 * have evaluated every web component while building a page that does not use
 * them.
 */
const SOURCES = import.meta.glob("../../../interfaces/src/components/*/*/*.ts")

type Category = "css" | "frame" | "standalone"

const categoryOf = new Map<string, Category>()
for (const path of Object.keys(SOURCES)) {
  const parts = path.split("/")
  const folder = parts.at(-2)
  const category = parts.at(-3) as Category
  if (folder && category) categoryOf.set(folder, category)
}

const GROUPS: { category: Category; title: string; explanation: string }[] = [
  {
    category: "css",
    title: "CSS components",
    explanation:
      "A class and a few data attributes on a plain HTML element. No JavaScript is loaded.",
  },
  {
    category: "frame",
    title: "Frame components",
    explanation:
      "You write the markup, and the web component adds keyboard handling, focus and the wiring on top. The elements stay in the plain DOM.",
  },
  {
    category: "standalone",
    title: "Standalone components",
    explanation:
      "The component creates its own content, because there is nothing for the server to send. You call a method.",
  },
]

const pages = (await getCollection("docs"))
  .filter((page) => page.id.startsWith("components/"))
  .map((page) => ({
    name: page.id.slice("components/".length),
    title: page.data.title,
    description: page.data.description ?? "",
    address: `/${page.id}/`,
  }))
  .filter((page) => page.name !== "" && !page.name.includes("/"))

const groups = GROUPS.map((group) => ({
  ...group,
  pages: pages
    .filter((page) => categoryOf.get(page.name) === group.category)
    .sort((a, b) => a.title.localeCompare(b.title, "en")),
})).filter((group) => group.pages.length > 0)

/*
 * An overview that has lost half its list looks like a short overview. So what
 * was actually placed is counted, and the build stops if a page fell out of the
 * categorisation.
 */
const placed = groups.reduce((sum, g) => sum + g.pages.length, 0)
if (placed !== pages.length) {
  const missing = pages
    .filter((s) => !categoryOf.has(s.name))
    .map((s) => s.name)
  throw new Error(
    `ComponentOverview: ${placed} of ${pages.length} pages ended up in a group. No folder under interfaces/src/components: ${missing.join(", ")}`,
  )
}
---

{
  groups.map((group) => (
    <section class="overview">
      <h2 id={group.category}>{group.title}</h2>
      <p>{group.explanation}</p>
      <ul class="overview__list">
        {group.pages.map((page) => (
          <li class="overview__card">
            <a href={page.address}>{page.title}</a>
            <span>{page.description}</span>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style>
  .overview__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--lt-spacing-3);
    margin-block: var(--lt-spacing-4);
    padding: 0;
    list-style: none;
  }

  .overview__card {
    display: flex;
    flex-direction: column;
    gap: var(--lt-spacing-1);
    padding: var(--lt-spacing-3);
    border: 1px solid var(--lt-color-neutral-border-subtle);
    border-radius: 0;
    background: var(--lt-color-neutral-surface);
  }

  .overview__card a {
    font-weight: 600;
  }

  .overview__card span {
    font-size: var(--lt-font-size-s);
    line-height: var(--lt-line-height-default);
    color: var(--lt-color-neutral-text-subtle);
    /* The descriptions are full sentences, and a long word must not burst
       the card on a narrow screen. */
    overflow-wrap: anywhere;
  }
</style>
