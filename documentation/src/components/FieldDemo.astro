---
import Preview from "./Preview.astro"
---

<Preview id="demo-field" stiler={["field"]} layout="stabel" maxWidth="34rem">
	<fs-field id="demo-epost-felt" required-marker="text">
		<label>E-postadresse</label>
		<input
			id="demo-epost-input"
			class="fs-input"
			type="email"
			placeholder="ola@eksempel.no"
		/>
		<p class="fs-help-text">Vi sender kvittering til denne adressen.</p>
		<p class="fs-error-text">Skriv en e-postadresse med krøllalfa.</p>
	</fs-field>

	<fs-field optional>
		<label>Melding til saksbehandler</label>
		<textarea class="fs-textarea" rows="3" placeholder="Skriv en kort melding"></textarea>
		<p class="fs-help-text">Du kan skrive opptil 500 tegn.</p>
	</fs-field>
</Preview>

<script>
	import { defineFsField } from "@fristil/designsystem/field"

	defineFsField()

	// Forhåndsvisningen ligger i en shadow root, så document.getElementById
	// når ikke inn. Vi går via vertselementet.
	const flate = document.getElementById("demo-field")?.shadowRoot
	const felt = flate?.getElementById("demo-epost-felt")
	const input = flate?.getElementById("demo-epost-input") as HTMLInputElement | null

	if (felt && input) {
		const erGyldig = () =>
			input.value === "" || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value)

		input.addEventListener("blur", () => {
			felt.toggleAttribute("invalid", !erGyldig())
		})

		input.addEventListener("input", () => {
			if (felt.hasAttribute("invalid")) {
				felt.toggleAttribute("invalid", !erGyldig())
			}
		})
	}
</script>
