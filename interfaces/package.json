  "files": [
    "agent",
    "dist",
    "web-types.json",
    "live-templates.xml",
    "manifest/manifest.json",
    "manifest/files.json",
    "core/lotek-core.wasm",
    "core/lotek.wasm",
    "manifest/manifest.schema.json",
    "src/*.ts",
    "src/diagnostics",
    "src/jsx",
    "src/tokens",
    "src/components",
    "src/tailwind",
    "src/vocabulary",
    "CHANGELOG.md",
    "!**/*.browser.test.ts",
    "!**/*.test.ts",
    "!**/*.tsbuildinfo"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "generate": "bun scripts/generate-matrix.ts && bun scripts/generate-tokens.ts && bun scripts/generate-tailwind.ts && bun scripts/generate-vocabulary.ts && bun scripts/generate-agent.ts && bun scripts/generate-manifest.ts",
    "build:css": "bun scripts/build-css.ts",
    "pack": "bun run core && rm -rf dist && tsc -b --force && bun run build:css && npm pack --ignore-scripts",
    "build:browser": "tsc -b && bun run build:css",
    "vocabulary": "bun scripts/generate-vocabulary.ts",
    "check:vocabulary": "bun scripts/check-vocabulary.ts",
    "core": "bun ../core/scripts/build.ts && mkdir -p core && cp ../core/dist/lotek-core.wasm ../core/dist/lotek.wasm core/",
    "build": "bun run core && bun run generate && rm -rf dist && tsc -b --force && bun run build:css && bun run check:exports && bun run check:server && bun run check:types && bun run check:writes && bun run check:test-files && bun run check:texts && bun run check:identifiers && bun run check:agent && bun run check:vocabulary && bun run check:css-witness && bun run check:wording && bun run check:cli && bun run check:version && bun run check:package",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test:browser": "vitest --config vitest.config.ts --run",
    "check:exports": "bun scripts/check-exports.ts",
    "check:server": "bun scripts/check-server-import.ts",
    "check:types": "bun scripts/check-types.ts",
    "check:tailwind": "bun scripts/check-tailwind.ts",
    "browsers": "playwright install chromium firefox webkit",
    "test:chromium": "vitest --config vitest.chromium.config.ts --run",
    "theme": "bun src/cli.ts",
    "check:cli": "bun scripts/check-cli.ts",
    "check:version": "bun scripts/check-version.ts",
    "check:package": "publint",
    "prepublishOnly": "bun run build",
    "check:writes": "bun scripts/check-writes.ts",
    "check:test-files": "bun scripts/check-test-files.ts",
    "check:identifiers": "bun scripts/check-identifiers.ts",
    "typecheck:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "check:wording": "bun scripts/check-wording.ts",
    "check:agent": "bun scripts/check-agent.ts",
    "check:css-witness": "bun scripts/check-css-witness.ts",
    "check:texts": "bun scripts/check-texts.ts",
    "check:without-javascript": "bun scripts/check-without-javascript.ts"
  },
  "devDependencies": {
    "@types/node": "24.12.4",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitest/browser": "4.1.7",
    "@vitest/browser-playwright": "^4.1.7",
    "axe-core": "^4.13.0",
    "playwright": "1.60.0",
    "publint": "^0.3.24",
    "react": "19",
    "react-dom": "19",
    "tailwindcss": "4.3.0",
    "vite": "7.0.0",
    "vitest": "4.1.7"
  }
}
