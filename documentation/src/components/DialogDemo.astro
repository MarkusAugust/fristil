---
import { lt } from "@lo-tek/interfaces"
import Preview from "./Preview.astro"

// Serveren skriver hele dialogen og sier om den er åpen. Komponenten kaller
// showModal(), som en server ikke kan gjøre selv.
const boks = lt.dialog({ titleId: "demo-dialog-tittel", color: "danger" })
---

<Preview id="demo-dialog" stiler={["dialog", "button"]} maxWidth="30rem">
	<button {...lt.button({ variant: "danger" })} type="button" data-apne>
		Slett søknaden
	</button>

	<lt-dialog {...boks.host}>
		<dialog {...boks.dialog}>
			<div {...boks.header}>
				<h2 {...boks.title}>Slette søknaden?</h2>
				<p {...boks.subtitle}>Dette kan ikke angres</p>
			</div>
			<div {...boks.body}>
				<p>Søknaden og vedleggene blir borte. Dette kan ikke angres.</p>
			</div>
			<form method="dialog" {...boks.footer}>
				<button {...lt.button({ variant: "secondary" })} value="avbryt">Avbryt</button>
				<button {...lt.button({ variant: "danger" })} value="slett">Slett søknaden</button>
			</form>
		</dialog>
	</lt-dialog>
</Preview>

<script>
	import { defineLtDialog } from "@lo-tek/interfaces/dialog"

	defineLtDialog()

	// I en app med server ville knappen sendt en forespørsel, og serveren
	// svart med den samme markupen og `open` på verten. Her gjør knappen det
	// serveren ellers ville gjort, slik at eksempelet kan prøves.
	const vert = document
		.getElementById("demo-dialog")
		?.shadowRoot?.querySelector("lt-dialog")

	document
		.getElementById("demo-dialog")
		?.shadowRoot?.querySelector("[data-apne]")
		?.addEventListener("click", () => vert?.setAttribute("open", ""))
</script>
