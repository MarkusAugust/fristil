---
import Preview from "./Preview.astro"
---

<Preview
	id="demo-liste"
	stiler={[
		"search",
		"tag",
		"table",
		"skeleton",
		"alert",
		"button",
		"label",
		"sr-only",
		"heading",
		"paragraph",
	]}
	layout="stabel"
	maxWidth="34rem"
	ekstraCss={`
		/* Oppsettet er appens, ikke systemets: Fristil gir søkefeltet,
		   merkelappene og tabellen, mens luften mellom dem hører til siden
		   som setter dem sammen. */
		#demo-liste-rot {
			display: flex;
			flex-direction: column;
			gap: var(--fs-spacing-5);
		}

		.demo-filtre {
			display: flex;
			flex-wrap: wrap;
			align-items: center;
			gap: var(--fs-spacing-2);
		}

		.demo-filtre h3 {
			flex-basis: 100%;
			margin: 0 0 var(--fs-spacing-1);
		}

		#demo-last-om-igjen {
			align-self: start;
		}
	`}
>
	<div id="demo-liste-rot">
		<form role="search" class="fs-search-row" id="demo-sok-skjema">
			<label class="fs-label fs-sr-only" for="demo-sok">Søk i saker</label>
			<input
				class="fs-input fs-search"
				type="search"
				id="demo-sok"
				name="q"
				placeholder="Søk i saker"
			/>
		</form>

		<div role="group" aria-labelledby="demo-filtre" class="demo-filtre">
			<h3 class="fs-heading" data-size="xs" id="demo-filtre">Status</h3>
			<button class="fs-tag" data-selectable aria-pressed="false" type="button" data-status="Innvilget">Innvilget</button>
			<button class="fs-tag" data-selectable aria-pressed="false" type="button" data-status="Under behandling">Under behandling</button>
			<button class="fs-tag" data-selectable aria-pressed="false" type="button" data-status="Avslått">Avslått</button>
		</div>

		<p class="fs-sr-only" role="status" id="demo-treff"></p>

		<div id="demo-resultat"></div>

		<button class="fs-button" data-variant="secondary" type="button" id="demo-last-om-igjen">
			Last listen på nytt
		</button>
	</div>
</Preview>

<script>
	type Sak = { nummer: string; dato: string; sendt: string; status: string }

	const SAKER: Sak[] = [
		{ nummer: "2026-0481", dato: "4. mars", sendt: "2026-03-04", status: "Under behandling" },
		{ nummer: "2026-0377", dato: "12. februar", sendt: "2026-02-12", status: "Innvilget" },
		{ nummer: "2025-1204", dato: "3. desember", sendt: "2025-12-03", status: "Avslått" },
		{ nummer: "2025-0988", dato: "14. oktober", sendt: "2025-10-14", status: "Innvilget" },
	]

	/*
	 * Sorteringen er demoens, ikke systemets. Fristil gir knappen og pila, og
	 * leser retningen fra `aria-sort`. Hvilken kolonne som er sortert, står
	 * bare her, og skrives ut som `aria-sort` på én overskrift.
	 */
	type Kolonne = "nummer" | "sendt"
	type Retning = "ascending" | "descending"
	let sortering: { kolonne: Kolonne; retning: Retning } = {
		kolonne: "sendt",
		retning: "descending",
	}
	let viste: Sak[] = []

	function sorter(saker: Sak[]): Sak[] {
		const { kolonne, retning } = sortering
		const fortegn = retning === "ascending" ? 1 : -1
		return [...saker].sort(
			(a, b) => fortegn * a[kolonne].localeCompare(b[kolonne]),
		)
	}

	function overskrift(kolonne: Kolonne, tekst: string): string {
		const sortert = sortering.kolonne === kolonne
		return `<th scope="col"${sortert ? ` aria-sort="${sortering.retning}"` : ""}>
			<button type="button" class="fs-table__sort" data-kolonne="${kolonne}">${tekst}</button>
		</th>`
	}

	const flate = document.getElementById("demo-liste")?.shadowRoot
	const rot = flate?.getElementById("demo-liste-rot")
	const resultat = flate?.getElementById("demo-resultat")
	const treff = flate?.getElementById("demo-treff")
	const sok = flate?.getElementById("demo-sok") as HTMLInputElement | null

	/** Demoen feiler med vilje hver tredje lasting, for å vise feiltilstanden. */
	let lastinger = 0

	function valgteFiltre(): string[] {
		return [...(rot?.querySelectorAll(".fs-tag[aria-pressed='true']") ?? [])].map(
			(knapp) => (knapp as HTMLElement).dataset.status ?? "",
		)
	}

	function visLaster() {
		if (!resultat) return
		resultat.innerHTML = `
			<div aria-busy="true">
				${'<div class="fs-skeleton" data-variant="text" aria-hidden="true"></div>'.repeat(3)}
			</div>`
		if (treff) treff.textContent = "Henter saker"
	}

	function visFeil() {
		if (!resultat) return
		resultat.innerHTML = `
			<div class="fs-alert" data-color="danger" role="alert">
				<p class="fs-alert__title">Klarte ikke å hente sakene</p>
				<p>Nettverket svarte ikke. Prøv igjen.</p>
			</div>`
		if (treff) treff.textContent = "Klarte ikke å hente sakene"
	}

	function visTomt(sokeord: string) {
		if (!resultat) return
		resultat.innerHTML = `
			<div>
				<p class="fs-paragraph"><strong id="demo-tomt"></strong></p>
				<p class="fs-paragraph" data-size="small">Prøv et annet søkeord, eller fjern filtrene.</p>
				<button class="fs-button" data-variant="secondary" type="button" id="demo-nullstill">
					Nullstill søket
				</button>
			</div>`
		// `textContent` og ikke rett i `innerHTML`: søketeksten er skrevet av
		// brukeren, og `<img onerror=…>` i søkefeltet ville blitt kjørt.
		const tomt = flate?.getElementById("demo-tomt")
		if (tomt) {
			tomt.textContent = `Ingen saker passer${sokeord ? ` med «${sokeord}»` : ""}.`
		}
		if (treff) treff.textContent = "Ingen treff"

		flate?.getElementById("demo-nullstill")?.addEventListener("click", () => {
			if (sok) sok.value = ""
			for (const knapp of rot?.querySelectorAll(".fs-tag") ?? []) {
				knapp.setAttribute("aria-pressed", "false")
			}
			tegn()
		})
	}

	function visSaker(saker: Sak[]) {
		if (!resultat) return
		viste = saker
		resultat.innerHTML = `
			<div class="fs-table-scroll" tabindex="0" role="region" aria-label="Saker">
				<table class="fs-table" data-variant="striped">
					<caption class="fs-sr-only">Saker som passer med søket. Kolonner med knapp kan sorteres.</caption>
					<thead>
						<tr>${overskrift("nummer", "Saksnummer")}${overskrift("sendt", "Sendt")}<th scope="col">Status</th></tr>
					</thead>
					<tbody>
						${sorter(saker)
							.map(
								(sak) => `<tr>
									<th scope="row">${sak.nummer}</th>
									<td>${sak.dato}</td>
									<td>${sak.status}</td>
								</tr>`,
							)
							.join("")}
					</tbody>
				</table>
			</div>`

		// Bare når antallet er et annet: sorteringen tegner de samme sakene på
		// nytt, og den samme teksten skrevet inn igjen leses opp på nytt.
		const antall = saker.length === 1 ? "1 sak" : `${saker.length} saker`
		if (treff && treff.textContent !== antall) treff.textContent = antall
	}

	function tegn() {
		lastinger += 1
		visLaster()

		window.setTimeout(() => {
			if (lastinger % 3 === 0) {
				visFeil()
				return
			}

			const sokeord = (sok?.value ?? "").trim().toLowerCase()
			const filtre = valgteFiltre()

			const passer = SAKER.filter(
				(sak) =>
					(sokeord === "" ||
						sak.nummer.toLowerCase().includes(sokeord) ||
						sak.status.toLowerCase().includes(sokeord)) &&
					(filtre.length === 0 || filtre.includes(sak.status)),
			)

			if (passer.length === 0) visTomt(sokeord)
			else visSaker(passer)
		}, 450)
	}

	// Søk mens brukeren skriver, men ikke ved hvert tastetrykk: antall treff
	// leses opp, og det ville avbrutt opplesingen hele tiden.
	let tidsavbrudd: number
	sok?.addEventListener("input", () => {
		window.clearTimeout(tidsavbrudd)
		tidsavbrudd = window.setTimeout(tegn, 300)
	})

	flate?.getElementById("demo-sok-skjema")?.addEventListener("submit", (hendelse) => {
		hendelse.preventDefault()
		tegn()
	})

	for (const knapp of rot?.querySelectorAll(".fs-tag[data-selectable]") ?? []) {
		knapp.addEventListener("click", () => {
			const valgt = knapp.getAttribute("aria-pressed") === "true"
			knapp.setAttribute("aria-pressed", String(!valgt))
			tegn()
		})
	}

	flate?.getElementById("demo-last-om-igjen")?.addEventListener("click", tegn)

	// Sorteringen henter ingenting på nytt, den tegner de samme sakene i ny
	// rekkefølge. Tabellen byttes ut, så fokus må settes tilbake på knappen
	// brukeren trykket på, ellers havner det på `<body>`.
	resultat?.addEventListener("click", (hendelse) => {
		const knapp = (hendelse.target as Element).closest<HTMLElement>(".fs-table__sort")
		const kolonne = knapp?.dataset.kolonne as Kolonne | undefined
		if (!kolonne) return

		sortering = {
			kolonne,
			retning:
				sortering.kolonne === kolonne && sortering.retning === "ascending"
					? "descending"
					: "ascending",
		}
		visSaker(viste)
		resultat
			.querySelector<HTMLElement>(`.fs-table__sort[data-kolonne="${kolonne}"]`)
			?.focus()
	})

	tegn()
</script>
