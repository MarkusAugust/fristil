---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components"
import Preview, { type Stilark } from "./Preview.astro"

interface Props {
  /** Stilarkene eksempelet trenger, de samme du ville importert i en app. */
  stiler?: Stilark[]
  /** `rad` legger innholdet side om side, `stabel` under hverandre. */
  layout?: "rad" | "stabel"
  /** Valgfri maksbredde, for eksempel "34rem". */
  maxWidth?: string
  /** Markupen. Vises både levende og som kode. */
  kode: string
  /**
   * CSS som bare gjelder forhåndsvisningen.
   *
   * Noen komponenter viser seg ikke av seg selv i en boks: hopplenken ligger
   * utenfor skjermen til den får fokus, og dialogen ligger i topplaget. Da
   * tvinges de fram her, framfor med `style=` i markupen. Det leseren
   * kopierer skal være det som virker i en ekte side.
   */
  visningsCss?: string
}

const { stiler, layout, maxWidth, kode, visningsCss } = Astro.props

/*
 * Markupen står ett sted.
 *
 * Før ble den skrevet to ganger, én gang i forhåndsvisningen og én gang i
 * kodefanen, og de hadde allerede drevet fra hverandre: badge-siden viste
 * <div> i forhåndsvisningen og <ul> i koden. Her er det samme streng som
 * rendres og vises, så de kan ikke gå i utakt.
 */
---

<Tabs>
	<TabItem label="Eksempel">
		<Preview stiler={stiler} layout={layout} maxWidth={maxWidth} ekstraCss={visningsCss}>
			<Fragment set:html={kode} />
		</Preview>
	</TabItem>
	<TabItem label="Kode">
		<Code code={kode.trim()} lang="html" />
	</TabItem>
</Tabs>
