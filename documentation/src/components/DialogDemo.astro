---
import { lt } from "@lo-tek/interfaces"
import Preview from "./Preview.astro"

// The server writes the whole dialog and says whether it is open. The
// component calls showModal(), which a server cannot do itself.
const box = lt.dialog({ titleId: "demo-dialog-title", color: "danger" })
---

<Preview id="demo-dialog" styles={["dialog", "button"]} maxWidth="30rem">
	<button {...lt.button({ variant: "danger" })} type="button" data-open>
		Delete the application
	</button>

	<lt-dialog {...box.host}>
		<dialog {...box.dialog}>
			<div {...box.header}>
				<h2 {...box.title}>Delete the application?</h2>
				<p {...box.subtitle}>This cannot be undone</p>
			</div>
			<div {...box.body}>
				<p>The application and its attachments will be gone. This cannot be undone.</p>
			</div>
			<form method="dialog" {...box.footer}>
				<button {...lt.button({ variant: "secondary" })} value="cancel">Cancel</button>
				<button {...lt.button({ variant: "danger" })} value="delete">Delete the application</button>
			</form>
		</dialog>
	</lt-dialog>
</Preview>

<script>
	import { defineLtDialog } from "@lo-tek/interfaces/dialog"

	defineLtDialog()

	// In an app with a server, the button would send a request, and the
	// server would answer with the same markup and `open` on the host. Here
	// the button does what the server would otherwise do, so the example can
	// be tried.
	const host = document
		.getElementById("demo-dialog")
		?.shadowRoot?.querySelector("lt-dialog")

	document
		.getElementById("demo-dialog")
		?.shadowRoot?.querySelector("[data-open]")
		?.addEventListener("click", () => host?.setAttribute("open", ""))
</script>
