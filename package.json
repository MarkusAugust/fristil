{
  "name": "fristil-monorepo",
  "private": true,
  "workspaces": [
    "designsystem",
    "documentation"
  ],
  "scripts": {
    "dev": "bun --filter @fristil/documentation dev",
    "build": "bun --filter @fristil/designsystem generate && tsc -b && bun --filter @fristil/documentation build",
    "typecheck": "tsc -b",
    "typecheck:tests": "bun --filter @fristil/designsystem typecheck:tests",
    "test": "bun --filter @fristil/designsystem test:browser",
    "test:docs": "bun --filter @fristil/documentation test:docs",
    "lint": "biome check ."
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
