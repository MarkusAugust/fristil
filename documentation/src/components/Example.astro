---
import { Code, TabItem, Tabs } from "@astrojs/starlight/components"
import pkg from "../../../interfaces/package.json"
import Preview, { type Stylesheet } from "./Preview.astro"

/** The addresses of the stylesheets, read from the package's own `exports`. */
const STYLESHEETS: Record<string, string> = Object.fromEntries(
  Object.entries(pkg.exports as Record<string, unknown>)
    .filter(([n, m]) => n.endsWith(".css") && typeof m === "string")
    .map(([n, m]) => [n.slice(2), (m as string).slice(2)]),
)

const CDN = `https://cdn.jsdelivr.net/npm/@lo-tek/interfaces@${pkg.version}`

interface Props {
  /** The stylesheets the example needs, the same ones you would import in an app. */
  styles?: Stylesheet[]
  /**
   * `row` lays the content out side by side, `stack` one below the other.
   * `flow` is ordinary block flow, where margins collapse as they do on a
   * real page. In `stack` the surface is a flex column, and there the
   * margins and the gap add up.
   */
  layout?: "row" | "stack" | "flow"
  /** Optional maximum width, for example "34rem". */
  maxWidth?: string
  /** The markup. Shown both live and as code. */
  code: string
  /**
   * CSS that applies only to the preview.
   *
   * Some components do not show themselves in a box: the skip link sits off
   * screen until it gets focus, and the dialog sits in the top layer. They
   * are forced into view here rather than with `style=` in the markup. What
   * the reader copies must be what works on a real page.
   */
  previewCss?: string
  /**
   * The stylesheets to show in the code tab, as they are imported in an app.
   *
   * Without them the code tab is only markup, and the reader has to look
   * further up the page for what must be imported to make it look like this.
   * With them the tab is the whole recipe.
   */
  imports?: string[]
  /**
   * CSS that belongs to the example, and that the reader should take along.
   *
   * The difference from `previewCss` is who it is for. `previewCss` forces
   * something into view that cannot otherwise be shown in a box, and is not
   * to be copied. This one is part of the recipe: the consumer's own classes,
   * such as `.compact-panel` on the customising page. That is why it is shown
   * in the code tab.
   *
   * Without the distinction, such CSS ended up in `previewCss`, and the code
   * tab then had classes that were not defined anywhere the reader could see.
   */
  customCss?: string
}

const { styles, layout, maxWidth, code, previewCss, imports, customCss } =
  Astro.props

const combinedPreviewCss = [customCss, previewCss].filter(Boolean).join("\n")

/*
 * The tab for the builder function, when the page has something to say there.
 *
 * It used to be a separate `## TypeScript` section further down. The css
 * pages had it and the nine with behaviour did not, since those show `lt` in
 * their React and Astro tabs instead. Now everything about how the component
 * is made is in the same section, on every page.
 */
const hasTypeScript = Astro.slots.has("ts")

/*
 * The stylesheets, in the form the tab they are in can actually use.
 *
 * "Plain HTML" is defined by having no build step, so it cannot say
 * `import "@lo-tek/interfaces/tokens.css"`: a browser does not resolve a
 * package name. There a `<link>` with the full address is written. The import
 * lines belong in the TypeScript tab, where there is a build step.
 */
const links =
  imports &&
  [
    ...imports.map(
      (file) =>
        `<link rel="stylesheet" href="${CDN}/${STYLESHEETS[file] ?? `src/${file}`}">`,
    ),
    /*
     * And the single file that replaces them.
     *
     * The list above is precise, and that is why it is there: it says what
     * the component requires. But "Getting started" recommends `lotek.css` to
     * anyone linking without a build step, and without this line the two
     * pages recommended different things. No page lists `tailwind.css` in
     * `imports`, which is the only stylesheet the combined file does not
     * cover, so the line is true everywhere.
     */
    `<!-- Or everything in one file: ${CDN}/${STYLESHEETS["lotek.css"]} -->`,
  ].join("\n")

const importLines = imports
  ?.map((file) => `import "@lo-tek/interfaces/${file}"`)
  .join("\n")

/*
 * The markup is in one place.
 *
 * It used to be written twice, once in the preview and once in the code tab,
 * and the two had already drifted apart: the badge page showed a <div> in the
 * preview and a <ul> in the code. Here the same string is rendered and shown,
 * so they cannot fall out of step.
 */
---

<Tabs>
	<TabItem label="Example">
		<Preview styles={styles} layout={layout} maxWidth={maxWidth} extraCss={combinedPreviewCss}>
			<Fragment set:html={code} />
		</Preview>
	</TabItem>
	<TabItem label="Plain HTML">
		{links && <Code code={links} lang="html" />}
		<Code code={code.trim()} lang="html" />
		{customCss && <Code code={customCss.trim()} lang="css" />}
	</TabItem>
	{
		hasTypeScript && (
			<TabItem label="TypeScript">
				{importLines && <Code code={importLines} lang="ts" />}
				<slot name="ts" />
			</TabItem>
		)
	}
</Tabs>
