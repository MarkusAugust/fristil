---
import { fs } from "@fristil/designsystem"
import Preview from "./Preview.astro"

// Serveren skriver koblingen: aria-controls på knappen, klassen og popover
// på panelet. Komponenten regner ut posisjonen og lukker ved klikk utenfor.
const boks = fs.popover({ id: "demo-popover-panel" })
const handlinger = [
  "Arkiver saken",
  "Last ned som PDF",
  "Del med saksbehandler",
]
---

<Preview id="demo-popover" stiler={["popover", "button", "list"]} maxWidth="30rem">
	<fs-popover placement="bottom-start" {...boks.host}>
		<button {...boks.trigger} {...fs.button({ variant: "secondary" })} type="button">
			Handlinger
		</button>

		<ul {...boks.panel}>
			{
				handlinger.map((tekst) => (
					<li>
						<button class="fs-button" data-variant="ghost" type="button">
							{tekst}
						</button>
					</li>
				))
			}
		</ul>
	</fs-popover>
</Preview>

<script>
	import { defineFsPopover } from "@fristil/designsystem/popover"

	defineFsPopover()
</script>
