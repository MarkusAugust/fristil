---
import Preview from "./Preview.astro"

interface Props {
  /** Token names without the `--` prefix, shown as one swatch each. */
  semantic?: string[]
  /** Families shown as a row with one square per role. */
  matrix?: string[]
}

/** The roles, in the same order as the contract lists them. */
const ROLES = [
  "surface",
  "border-subtle",
  "border",
  "border-strong",
  "fill",
  "content",
  "text-subtle",
  "text",
  "text-strong",
]

const { semantic = [], matrix = [] } = Astro.props
---

<Preview layout="stack" maxWidth="34rem">
	<div style="display: grid; gap: var(--lt-spacing-2);">
		{semantic.map((name) => (
			<div style="display: flex; align-items: center; gap: var(--lt-spacing-3);">
				<span
					style={`width: var(--lt-spacing-10); height: var(--lt-spacing-6); border-radius: var(--lt-spacing-1); border: 1px solid var(--lt-color-neutral-border-subtle); background: var(--${name})`}
				/>
				<code style="font-size: var(--lt-font-size-s);">--{name}</code>
			</div>
		))}

		{matrix.map((family) => (
			<div style="display: flex; gap: var(--lt-spacing-1); align-items: center;">
				<code style="font-size: var(--lt-font-size-xs); width: 5.5rem;">{family}</code>
				{ROLES.map((role) => (
					<span
						title={`--lt-color-${family}-${role}`}
						style={`flex: 1; height: var(--lt-spacing-6); border: 1px solid var(--lt-color-neutral-border-subtle); background: var(--lt-color-${family}-${role})`}
					/>
				))}
			</div>
		))}
	</div>
</Preview>
