---
/**
 * The documentation's body text, with one addition: tables that do not scroll
 * are not tab stops.
 *
 * Every table gets a scroll container with `tabindex="0"` from
 * `src/plugins/rehype-table-scroll.mjs`, so the columns beyond the edge can be
 * reached with the keyboard. On a wide screen none of them scroll, and then
 * the 150 stops are only noise for someone tabbing through the page. The
 * script below removes `tabindex` again when the table fits, and puts it back
 * when the window shrinks.
 *
 * The attribute is in the HTML and removed by script, not the other way
 * round: without JavaScript the reader keeps access to the columns.
 *
 * The same goes for `role="region"` and the text that names the region: a
 * table that fits must not be in the screen reader's list of regions.
 *
 * The script also sets `data-mer-venstre` and `data-mer-hoyre`, which
 * global.css draws a shadow from. Without it, a cut-off column looks as if
 * the table ends there.
 */

import Default from "@astrojs/starlight/components/MarkdownContent.astro"
---

<Default><slot /></Default>

<script>
	for (const rullefelt of document.querySelectorAll<HTMLElement>(
		".tabell-rull",
	)) {
		const navn = rullefelt.getAttribute("aria-label") ?? ""

		const oppdater = () => {
			const ruller = rullefelt.scrollWidth > rullefelt.clientWidth

			// A table that fits is neither a tab stop nor a region of its own
			// in the screen reader's list.
			if (ruller) {
				rullefelt.setAttribute("tabindex", "0")
				rullefelt.setAttribute("role", "region")
				if (navn) rullefelt.setAttribute("aria-label", navn)
			} else {
				rullefelt.removeAttribute("tabindex")
				rullefelt.removeAttribute("role")
				rullefelt.removeAttribute("aria-label")
			}

			// The shadow at the edge says there is more to see that way.
			rullefelt.toggleAttribute("data-mer-venstre", rullefelt.scrollLeft > 1)
			rullefelt.toggleAttribute(
				"data-mer-hoyre",
				ruller &&
					rullefelt.scrollLeft + rullefelt.clientWidth <
						rullefelt.scrollWidth - 1,
			)
		}

		oppdater()
		new ResizeObserver(oppdater).observe(rullefelt)
		rullefelt.addEventListener("scroll", oppdater, { passive: true })
	}
</script>
