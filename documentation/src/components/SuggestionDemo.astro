---
import { lt } from "@lo-tek/interfaces"
import Preview from "./Preview.astro"

// The key is the city's code: it gives each option a fixed id, so an
// update from the server recognises the option.
const kommuner = [
  { nr: "abd", navn: "Aberdeen" },
  { nr: "bel", navn: "Belfast" },
  { nr: "bol", navn: "Bolton" },
  { nr: "bou", navn: "Bournemouth" },
  { nr: "car", navn: "Cardiff" },
  { nr: "yor", navn: "York" },
]

// The server writes the field and the list. The component filters and handles the keyboard.
const forslag = lt.suggestion({
  id: "demo-kommune",
  keys: kommuner.map((k) => k.nr),
  help: true,
})
---

<Preview id="demo-suggestion" styles={["suggestion", "label", "input", "help-text", "sr-only"]} maxWidth="30rem">
	<lt-suggestion>
		<label {...forslag.label}>City</label>
		<input {...forslag.control} name="city" placeholder="Start typing" />
		<ul {...forslag.list}>
			{forslag.options.map((valg, i) => <li {...valg}>{kommuner[i].navn}</li>)}
		</ul>
		<p {...forslag.empty}>No matches</p>
		<span {...forslag.status}></span>
		<p class="lt-help-text" {...forslag.help}>We fill in the rest of the address for you.</p>
	</lt-suggestion>
</Preview>

<script>
	import { defineLtSuggestion } from "@lo-tek/interfaces/suggestion"

	defineLtSuggestion()
</script>
