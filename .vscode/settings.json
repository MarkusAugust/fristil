{
  // Biome formaterer og linter. Den har siste ordet i dette repoet, og
  // `bun run lint` kjører nøyaktig det samme.
  "biome.enabled": true,
  "editor.defaultFormatter": "biomejs.biome",
  "editor.codeActionsOnSave": {
    "source.organizeImports": "always",
    "source.fixAll.biome": "always"
  },

  // MDX-språktjeneren er av. Slå den på igjen hvis du vil ha hjelp i
  // dokumentasjonssidene; den er ikke nødvendig for at noe skal bygge.
  "mdx.server.enable": false
}
