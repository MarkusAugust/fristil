---
import Preview from "./Preview.astro"

interface Props {
  /** Semantiske tokennavn, uten `--`-prefiks. */
  semantiske?: string[]
  /** Palettskalaer: navn → trinn. */
  palett?: Record<string, (number | string)[]>
}

const { semantiske = [], palett = {} } = Astro.props
---

<Preview layout="stabel" maxWidth="34rem">
	<div style="display: grid; gap: var(--size-2);">
		{semantiske.map((navn) => (
			<div style="display: flex; align-items: center; gap: var(--size-3);">
				<span
					style={`width: var(--size-10); height: var(--size-6); border-radius: var(--size-1); border: 1px solid var(--semantic-divider-30); background: var(--${navn})`}
				/>
				<code style="font-size: var(--font-size-s);">--{navn}</code>
			</div>
		))}

		{Object.entries(palett).map(([farge, trinn]) => (
			<div style="display: flex; gap: var(--size-1); align-items: center;">
				<code style="font-size: var(--font-size-xs); width: 5.5rem;">{farge}</code>
				{trinn.map((t) => (
					<span
						style={`flex: 1; height: var(--size-6); border: 1px solid var(--semantic-divider-30); background: var(--palette-${farge}-${t})`}
					/>
				))}
			</div>
		))}
	</div>
</Preview>
