{
  "name": "@fristil/designsystem",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./tokens.css": "./src/tokens/tokens.css",
    "./utilities.css": "./src/tokens/utilities.css",
    "./button.css": "./src/components/pure-css/button/button.css",
    "./button": {
      "import": "./dist/components/pure-css/button/button.js",
      "types": "./dist/components/pure-css/button/button.d.ts"
    },
    "./tokens": {
      "import": "./dist/tokens/tokens.js",
      "types": "./dist/tokens/tokens.d.ts"
    },
    "./tailwind": {
      "import": "./dist/tailwind/preset.js",
      "types": "./dist/tailwind/preset.d.ts"
    }
  },
  "files": [
    "dist",
    "src/tokens",
    "src/components"
  ],
  "scripts": {
    "generate": "bun scripts/generate-tokens.ts",
    "build": "bun run generate && tsc -b",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test:browser": "vitest --config vitest.config.ts --run"
  },
  "peerDependencies": {
    "lit": ">=3.0.0",
    "tailwindcss": ">=4.3.0"
  },
  "peerDependenciesMeta": {
    "tailwindcss": {
      "optional": true
    },
    "lit": {
      "optional": true
    }
  },
  "devDependencies": {
    "@vitest/browser": "4.1.7",
    "lit": "3.3.3",
    "playwright": "1.60.0",
    "tailwindcss": "4.3.0",
    "vite": "7.0.0",
    "vitest": "4.1.7"
  }
}
