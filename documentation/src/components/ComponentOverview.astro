---
/**
 * The overview of every component, read from what exists.
 *
 * Nothing here is written by hand. The title and description come from the
 * frontmatter of each component page, and the category from the folder the
 * component sits in under `designsystem/src/components/`. The list can then
 * neither run empty nor drift from the pages: a new component appears by
 * itself, and a description changed here is the same one as on the page.
 *
 * The sources are loaded with `import.meta.glob`, which Vite resolves at build
 * time. A path computed from `import.meta.url` would have pointed at the chunk
 * after bundling, not at the source, as `llms.txt.ts` explains in the same place.
 */

import { getCollection } from "astro:content"

/*
 * The folder name of each component, with the category it sits under.
 *
 * Without `eager`: we only need the paths, not the modules. Running them would
 * have evaluated every web component while building a page that does not use
 * them.
 */
const KILDER = import.meta.glob("../../../designsystem/src/components/*/*/*.ts")

type Kategori = "css" | "frame" | "standalone"

const kategoriFor = new Map<string, Kategori>()
for (const sti of Object.keys(KILDER)) {
  const deler = sti.split("/")
  const mappe = deler.at(-2)
  const kategori = deler.at(-3) as Kategori
  if (mappe && kategori) kategoriFor.set(mappe, kategori)
}

const GRUPPER: { kategori: Kategori; tittel: string; forklaring: string }[] = [
  {
    kategori: "css",
    tittel: "CSS components",
    forklaring:
      "A class and a few data attributes on a plain HTML element. No JavaScript is loaded.",
  },
  {
    kategori: "frame",
    tittel: "Frame components",
    forklaring:
      "You write the markup, and the web component adds keyboard handling, focus and the wiring on top. The elements stay in the plain DOM.",
  },
  {
    kategori: "standalone",
    tittel: "Standalone components",
    forklaring:
      "The component creates its own content, because there is nothing for the server to send. You call a method.",
  },
]

const sider = (await getCollection("docs"))
  .filter((side) => side.id.startsWith("components/"))
  .map((side) => ({
    navn: side.id.slice("components/".length),
    tittel: side.data.title,
    beskrivelse: side.data.description ?? "",
    adresse: `/${side.id}/`,
  }))
  .filter((side) => side.navn !== "" && !side.navn.includes("/"))

const grupper = GRUPPER.map((gruppe) => ({
  ...gruppe,
  sider: sider
    .filter((side) => kategoriFor.get(side.navn) === gruppe.kategori)
    .sort((a, b) => a.tittel.localeCompare(b.tittel, "en")),
})).filter((gruppe) => gruppe.sider.length > 0)

/*
 * An overview that has lost half its list looks like a short overview. So what
 * was actually placed is counted, and the build stops if a page fell out of the
 * categorisation.
 */
const plassert = grupper.reduce((sum, g) => sum + g.sider.length, 0)
if (plassert !== sider.length) {
  const borte = sider.filter((s) => !kategoriFor.has(s.navn)).map((s) => s.navn)
  throw new Error(
    `ComponentOverview: ${plassert} of ${sider.length} pages ended up in a group. No folder under designsystem/src/components: ${borte.join(", ")}`,
  )
}
---

{
  grupper.map((gruppe) => (
    <section class="oversikt">
      <h2 id={gruppe.kategori}>{gruppe.tittel}</h2>
      <p>{gruppe.forklaring}</p>
      <ul class="oversikt__liste">
        {gruppe.sider.map((side) => (
          <li class="oversikt__kort">
            <a href={side.adresse}>{side.tittel}</a>
            <span>{side.beskrivelse}</span>
          </li>
        ))}
      </ul>
    </section>
  ))
}

<style>
  .oversikt__liste {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(15rem, 1fr));
    gap: var(--lt-spacing-3);
    margin-block: var(--lt-spacing-4);
    padding: 0;
    list-style: none;
  }

  .oversikt__kort {
    display: flex;
    flex-direction: column;
    gap: var(--lt-spacing-1);
    padding: var(--lt-spacing-3);
    border: 1px solid var(--lt-color-neutral-border-subtle);
    border-radius: var(--lt-spacing-2);
    background: var(--lt-color-neutral-surface);
  }

  .oversikt__kort a {
    font-weight: 600;
  }

  .oversikt__kort span {
    font-size: var(--lt-font-size-s);
    line-height: var(--lt-line-height-default);
    color: var(--lt-color-neutral-text-subtle);
    /* The descriptions are full sentences, and a long word must not burst
       the card on a narrow screen. */
    overflow-wrap: anywhere;
  }
</style>
