---
import Preview from "./Preview.astro"
---

<Preview id="demo-dato" stiler={["field", "button", "paragraph"]} maxWidth="26rem" layout="kolonne">
	<lt-field>
		<label class="lt-label" for="demo-dato-fodt">Fødselsdato</label>
		<input
			class="lt-input"
			data-variant="date"
			id="demo-dato-fodt"
			name="fodselsdato"
			type="date"
			min="1900-01-01"
			max="2026-12-31"
		/>
		<p class="lt-help-text">Skriv datoen som 31.05.2026, eller velg den i kalenderen.</p>
	</lt-field>

	<p class="lt-paragraph" id="demo-dato-svar">Ingen dato valgt ennå.</p>
</Preview>

<script>
	import { defineLtField } from "@lo-tek/interfaces/field"

	defineLtField()

	// Forhåndsvisningen ligger i en shadow root, så vi går via vertselementet.
	const flate = document.getElementById("demo-dato")?.shadowRoot
	const felt = flate?.getElementById("demo-dato-fodt") as HTMLInputElement | null
	const svar = flate?.getElementById("demo-dato-svar")

	felt?.addEventListener("change", () => {
		if (!svar) return
		svar.textContent = felt.value
			? `Serveren får ${felt.value}, uansett hvordan datoen ser ut i feltet.`
			: "Ingen dato valgt ennå."
	})
</script>
