---
import Preview from "./Preview.astro"
---

<Preview id="demo-session" styles={["session-timeout", "button", "sr-only"]} maxWidth="34rem">
	<p class="lt-paragraph">
		Here the session is set to five seconds, so you do not have to wait 25 minutes.
		Stop touching the keyboard and mouse, and the warning appears.
	</p>
	<lt-session-timeout
		class="lt-session-timeout"
		warn-at="5"
		expires-at="65"
		data-ignore-morph>
		<dialog class="lt-session-timeout__dialog" role="alertdialog" aria-labelledby="demo-session-title">
			<h2 class="lt-session-timeout__title" id="demo-session-title">You will soon be signed out</h2>
			<p class="lt-session-timeout__text">
				We will sign you out in <span class="lt-session-timeout__count" aria-hidden="true"></span>
				to protect your information.
			</p>
			<span class="lt-sr-only" role="status"></span>
			<form method="dialog" class="lt-session-timeout__actions">
				<button class="lt-button" value="extend">Stay signed in</button>
				<button class="lt-button" data-variant="secondary" value="logout">Sign out now</button>
			</form>
		</dialog>
	</lt-session-timeout>
</Preview>

<script>
	import { defineLtSessionTimeout } from "@lo-tek/interfaces/session-timeout"

	defineLtSessionTimeout()
</script>
