---
import Preview from "./Preview.astro"
---

<Preview id="demo-field" styles={["field"]} layout="stack" maxWidth="34rem">
	<lt-field>
		<label class="lt-label" for="demo-epost-input" data-required="text">Email address</label>
		<input
			id="demo-epost-input"
			class="lt-input"
			type="email"
			placeholder="jo@example.com"
			required
		/>
		<p class="lt-help-text">We send the receipt to this address.</p>
		<p class="lt-error-text" id="demo-epost-feil" hidden>Enter an email address with an @ sign.</p>
	</lt-field>

	<lt-field optional="">
		<label for="demo-melding">Message to the caseworker</label>
		<textarea id="demo-melding" class="lt-textarea" rows="3" placeholder="Write a short message"></textarea>
		<p class="lt-help-text">You can write up to 500 characters.</p>
	</lt-field>
</Preview>

<script>
	import { defineLtField } from "@lo-tek/interfaces/field"

	defineLtField()

	// The preview sits in a shadow root, so document.getElementById does
	// not reach inside. We go through the host element.
	const flate = document.getElementById("demo-field")?.shadowRoot
	const feil = flate?.getElementById("demo-epost-feil")
	const input = flate?.getElementById("demo-epost-input") as HTMLInputElement | null

	if (feil && input) {
		const erGyldig = () =>
			input.value === "" || /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(input.value)

		// The field is invalid while the error text is visible. The component
		// then sets aria-invalid and wires the message to the field.
		input.addEventListener("blur", () => {
			feil.hidden = erGyldig()
		})

		input.addEventListener("input", () => {
			if (!feil.hidden) feil.hidden = erGyldig()
		})
	}
</script>
