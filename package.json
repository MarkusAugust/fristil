{
  "name": "fristil-monorepo",
  "private": true,
  "workspaces": [
    "designsystem",
    "documentation",
    "editor"
  ],
  "scripts": {
    "dev": "bun --filter @fristil/documentation dev",
    "build": "bun --filter @fristil/designsystem build && bun --filter fristil-vscode sjekk && bun --filter @fristil/documentation build",
    "typecheck": "tsc -b && bun --filter @fristil/designsystem typecheck:scripts && bun --filter fristil-vscode typecheck",
    "typecheck:tests": "bun --filter @fristil/designsystem typecheck:tests",
    "test": "bun --filter @fristil/designsystem test:browser && bun --filter @fristil/designsystem sjekk:tailwind",
    "test:docs": "bun --filter @fristil/documentation test:docs",
    "lint": "biome check .",
    "prepare-version": "bun designsystem/scripts/prepare-version.ts",
    "tag": "bun designsystem/scripts/tag.ts",
    "sjekk": "bun scripts/sjekk.ts",
    "sjekk:forfattere": "bun designsystem/scripts/sjekk-forfattere.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.16",
    "@types/bun": "1.3.14",
    "typescript": "6.0.3"
  }
}
