<div class="calendar-demo">
  <fs-calendar id="invoice-calendar" value="2026-05-31"></fs-calendar>
</div>

<script>
  import { defineDsCalendar } from "@fristil/designsystem/calendar"

  defineDsCalendar()

  const calendar = document.getElementById("invoice-calendar")
  if (calendar) {
    calendar.addEventListener("date-select", (event) => {
      const dateSelectEvent = event as CustomEvent<{ value: string }>
      console.log("Valgt dato:", dateSelectEvent.detail.value)
    })
  }
</script>
