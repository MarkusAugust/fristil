---
import Preview from "./Preview.astro"
---

<Preview maxWidth="30rem">
	<fs-calendar id="demo-kalender" value="2026-05-31"></fs-calendar>
	<p style="margin: 0;">
		Valgt dato: <output id="demo-kalender-resultat" style="font-weight: 600;">2026-05-31</output>
	</p>
</Preview>

<script>
	import { defineFsCalendar } from "@fristil/designsystem/calendar"

	defineFsCalendar()

	const kalender = document.getElementById("demo-kalender")
	const resultat = document.getElementById("demo-kalender-resultat")

	kalender?.addEventListener("date-select", (hendelse) => {
		const valg = hendelse as CustomEvent<{ value: string }>
		if (resultat) {
			resultat.textContent = valg.detail.value
		}
	})
</script>
