---
import Preview from "./Preview.astro"
---

<Preview
	id="demo-bekreft"
	stiler={["dialog", "button", "toast", "paragraph"]}
	layout="stabel"
	maxWidth="34rem"
>
	<p class="lt-paragraph">Application 2026-0481, sent 4 March.</p>

	<button class="lt-button" data-variant="danger" type="button" id="demo-slett">
		Delete the application
	</button>

	<dialog class="lt-dialog" id="demo-dialog" aria-labelledby="demo-dialog-tittel">
		<h2 class="lt-dialog__title" id="demo-dialog-tittel">Delete the application?</h2>

		<div class="lt-dialog__body">
			<p class="lt-paragraph">
				The application and its attachments will be gone. This cannot be undone.
			</p>
		</div>

		<form method="dialog" class="lt-dialog__footer">
			<button class="lt-button" data-variant="secondary" value="cancel">Cancel</button>
			<button class="lt-button" data-variant="danger" value="delete">Delete the application</button>
		</form>
	</dialog>

	<lt-toast id="demo-meldinger" label="Notifications"></lt-toast>
</Preview>

<script>
	import { defineLtToast } from "@lo-tek/interfaces/toast"

	defineLtToast()

	const flate = document.getElementById("demo-bekreft")?.shadowRoot
	const dialog = flate?.getElementById("demo-dialog") as HTMLDialogElement | null
	const meldinger = flate?.getElementById("demo-meldinger") as
		| (HTMLElement & { show(tekst: string, valg?: { color?: string }): void })
		| null

	flate?.getElementById("demo-slett")?.addEventListener("click", () => {
		if (!dialog) return
		// Escape and close() without a value leave the previous value in place.
		dialog.returnValue = ""
		dialog.showModal()
	})

	dialog?.addEventListener("close", () => {
		if (dialog.returnValue !== "delete") return

		// The action has been carried out. The message confirms it, but is not
		// the place for an undo button: it disappears.
		meldinger?.show("The application has been deleted", { color: "success" })
	})
</script>
