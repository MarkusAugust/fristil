---
import { lt } from "@lo-tek/interfaces"
import Preview from "./Preview.astro"

// The server writes the wiring: aria-controls on the button, the class and
// popover on the panel. The component computes the position and closes on a
// click outside.
const box = lt.popover({ id: "demo-popover-panel" })
const actions = [
  "Archive the case",
  "Download as PDF",
  "Share with a caseworker",
]
---

<Preview id="demo-popover" styles={["popover", "button"]} maxWidth="30rem">
	<lt-popover placement="bottom-start" {...box.host}>
		<button {...box.trigger} {...lt.button({ variant: "secondary" })} type="button">
			Actions
		</button>

		<ul {...box.panel}>
			{
				actions.map((text) => (
					<li>
						<button class="lt-button" data-variant="ghost" type="button">
							{text}
						</button>
					</li>
				))
			}
		</ul>
	</lt-popover>
</Preview>

<script>
	import { defineLtPopover } from "@lo-tek/interfaces/popover"

	defineLtPopover()
</script>
